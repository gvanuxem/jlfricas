testcase "NMUnivariatePolynomial nested (Fateman's benchmark)"
 
   All user variables and function definitions have been cleared.
R := NUP(NINT, 'x)
 

   (2)  NMUnivariatePolynomial(NMInteger,x)
x := x::R
 

   (3)  x
RR := NUP(R, 'y)
 

   (4)  NMUnivariatePolynomial(NMUnivariatePolynomial(NMInteger,x),y)
y := y::RR
 

   (5)  y
RRR := NUP(RR, 'z)
 

   (6)
   NMUnivariatePolynomial
      NMUnivariatePolynomial(NMUnivariatePolynomial(NMInteger,x),y)
  ,
      z
z := z::RRR
 

   (7)  z
T := NUP(RRR, 't)
 

   (8)
   NMUnivariatePolynomial
      NMUnivariatePolynomial
         NMUnivariatePolynomial(NMUnivariatePolynomial(NMInteger,x),y)
     ,
         z
  ,
      t
t := t::T
 

   (9)  t
p := (1 + x + y + z + t)^2
 

   (10)
      2                             2                       2                 2
     z  + (2 y + 2 x + 2 t + 2)z + y  + (2 x + 2 t + 2)y + x  + (2 t + 2)x + t
   + 
     2 t + 1
testEquals("degree(p)", "2")
 
q := p * (p + 1)
 

   (12)
      4                         3
     z  + (4 y + 4 x + 4 t + 4)z
   + 
         2                            2                     2             2
     (6 y  + (12 x + 12 t + 12)y + 6 x  + (12 t + 12)x + 6 t  + 12 t + 7)z
   + 
            3                      2
         4 y  + (12 x + 12 t + 12)y
       + 
              2                      2                    3               2
         (12 x  + (24 t + 24)x + 12 t  + 24 t + 14)y + 4 x  + (12 t + 12)x
       + 
              2                    3       2
         (12 t  + 24 t + 14)x + 4 t  + 12 t  + 14 t + 6
    *
       z
   + 
      4                   3       2                     2             2
     y  + (4 x + 4 t + 4)y  + (6 x  + (12 t + 12)x + 6 t  + 12 t + 7)y
   + 
         3               2        2                    3       2
     (4 x  + (12 t + 12)x  + (12 t  + 24 t + 14)x + 4 t  + 12 t  + 14 t + 6)y
   + 
      4             3       2             2       3       2                 4
     x  + (4 t + 4)x  + (6 t  + 12 t + 7)x  + (4 t  + 12 t  + 14 t + 6)x + t
   + 
        3      2
     4 t  + 7 t  + 6 t + 2
testEquals("degree(q)", "4")
 

testcase "NMMultivariatePolynomial nested"
 
   All user variables and function definitions have been cleared.
VarSet1 : List Symbol := [x,y]
 

   (2)  [x, y]
V1 := OrderedVariableList(VarSet1)
 

   (3)  OrderedVariableList([x, y])
R1 := NMP(NINT, VarSet1)
 

   (4)  NMMultivariatePolynomial(NMInteger,[x, y])
x1 := x::V1::R1
 

   (5)  x
y1 := y::V1::R1
 

   (6)  y
VarSet2 : List Symbol := [z,t]
 

   (7)  [z, t]
V2 := OrderedVariableList(VarSet2)
 

   (8)  OrderedVariableList([z, t])
R2 := NMP(R1, VarSet2)
 

   (9)
   NMMultivariatePolynomial(NMMultivariatePolynomial(NMInteger,[x, y]),[z, t])
z2 := z::V2::R2
 

   (10)  z
t2 := t::V2::R2
 

   (11)  t
p := x1::R2 + y1::R2 + z2 + t2
 

   (12)  z + y + x + t
testEquals("degree(p,1)", "1")
 
testEquals("degree(p,2)", "1")
 
q := p^2
 

          2                         2                   2            2
   (15)  z  + (2 y + 2 x + 2 t)z + y  + (2 x + 2 t)y + x  + 2 t x + t
testEquals("degree(q,1)", "2")
 

testcase "NMPolynomial nested"
 
   All user variables and function definitions have been cleared.
R1 := NPOLY(NINT)
 

   (2)  NMPolynomial(NMInteger)
x1 := x::Symbol::R1
 

   (3)  x
testEquals("length(x1)", "1")
 
R2 := NPOLY(R1)
 

   (5)  NMPolynomial(NMPolynomial(NMInteger))
y2 := y::Symbol::R2
 

   (6)  y
x1R2 := x1::R2
 

   (7)  x
p1 := x1R2 + x1R2
 

   (8)  2 x
p2 := y2 + y2
 

   (9)  2 y
-- Check constructOrdered
terms := [[x::Symbol, 1$R1]$Record(k: Symbol, c: R1)]$List(Record(k: Symbol, c: R1))
 

   (10)  [[k = x, c = 1]]
-- constructOrdered(terms)$R2 -- This might fail if not exposed or signature mismatch
-- Test monomial
E := IndexedExponents(Symbol)
 

   (11)  IndexedExponents(Symbol)
k0 := 0$E
 

   (12)  1
m := monomial(1$R1, k0)$R2
 

   (13)  1

p_nested : R2 := x1::R2 + y2
 

   (14)  y + x
testEquals("length(p_nested)", "2")
 
q_nested := p_nested^2
 

          2            2
   (16)  y  + 2 x y + x
testEquals("length(q_nested)", "3")
 

