testEquals("degree(ip)", "3")
 

testcase "NMUnivariatePolynomial gcd and lcm"
 
   All user variables and function definitions have been cleared.
x := x::NUP(NINT,'x)
 

   (2)  x
p := (x + 1) * (x + 2)
 

         2
   (3)  x  + 3 x + 2
q := (x + 1) * (x + 3)
 

         2
   (4)  x  + 4 x + 3
g := gcd(p, q)
 

   (5)  x + 1
testEquals("degree(g)", "1")
 
l := lcm(p, q)
 

         3      2
   (7)  x  + 6 x  + 11 x + 6
testEquals("degree(l)", "3")
 

