testcase "solveUniquely"
 
   All user variables and function definitions have been cleared.
                                                                   Type: Void

m := matrix([[2, 3], [3, -1]])
 

        +2   3 +
   (2)  |      |
        +3  - 1+
                                                        Type: Matrix(Integer)
x0 := vector([2,-3])
 

   (3)  [2, - 3]
                                                        Type: Vector(Integer)
y := m*x0
 

   (4)  [- 5, 9]
                                                        Type: Vector(Integer)
lSMP := LinearSystemMatrixPackage2(Integer)
 

   (5)  LinearSystemMatrixPackage2(Integer)
                                                                   Type: Type
xu := solveUniquely(m, y)$lSMP
 

   (6)  [2, - 3]
                                             Type: Union(Vector(Integer),...)
testTrue("xu case Vector(Integer)")
 
                                                                   Type: Void
testEquals("xu::Vector(Integer)", "x0")
 
                                                                   Type: Void

xu := solveUniquely(m, vector([1,1]))$lSMP
 

   (9)  "failed"
                                                    Type: Union("failed",...)
testTrue("not(xu case Vector(Integer))")
 
                                                                   Type: Void

