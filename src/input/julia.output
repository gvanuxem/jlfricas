cmat  := matrix([[cone, czero],[czero, cone]])@JCF64MAT;
 

testTrue("jlApprox?(0$JF64,0$JF64)")
 
testTrue("jlApprox?(cone,cone)")
 
testTrue("jlApprox?(vec,vec)")
 
