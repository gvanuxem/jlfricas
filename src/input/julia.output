d4 := d1 * d2
 

   (6)  -5.0 + 10.0 %i
testTrue("jlApprox?(d4, jcf64(-5.0::DoubleFloat::JLFloat64, 10.0::DoubleFloat::JLFloat64))")
 
testTrue("jlApprox?(real(d1), 1.0::JLFloat64)")
 
testTrue("jlApprox?(imag(d1), 2.0::JLFloat64)")
 

