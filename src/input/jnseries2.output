--Copyright G. Vanuxem 2025.

--% Nemo Series Test (extended)
-- Testing Nemo power series, Laurent series, and Puiseux series
-- Author: G. Vanuxem
-- Date Created: 2025-12-03
-- Date Last Updated: 2025-12-03
-- Keywords: Nemo series, power series, Laurent series, Puiseux series

)set break resume
 
)set mess type off
 
)expose UnittestCount UnittestAux Unittest
 
   UnittestCount is now explicitly exposed in frame initial 
   UnittestAux is now explicitly exposed in frame initial 
   Unittest is now explicitly exposed in frame initial 

testsuite "Nemo Series Extended Tests"
 
   All user variables and function definitions have been cleared.
   WARNING: string for testsuite should have less than 15 characters!

testcase "NMUnivariatePowerSeries - trigonometric"
 
   All user variables and function definitions have been cleared.
R := NUPS(NFRAC(NINT),'x,30,"capped_relative")
 

   (2)  NMUnivariatePowerSeries(NMFraction(NMInteger),x,30,:capped_relative)
x := x::R
 

   (3)  x + O(x^31)
s1 := sin(x)
 

   (4)
  x - 1/6*x^3 + 1/120*x^5 - 1/5040*x^7 + 1/362880*x^9 - 1/39916800*x^11 + 1/622
  7020800*x^13 - 1/1307674368000*x^15 + 1/355687428096000*x^17 - 1/121645100408
  832000*x^19 + 1/51090942171709440000*x^21 - 1/25852016738884976640000*x^23 + 
  1/15511210043330985984000000*x^25 - 1/10888869450418352160768000000*x^27 + 1/
  8841761993739701954543616000000*x^29 + O(x^31)
c1 := cos(x)
 

   (5)
  1 - 1/2*x^2 + 1/24*x^4 - 1/720*x^6 + 1/40320*x^8 - 1/3628800*x^10 + 1/4790016
  00*x^12 - 1/87178291200*x^14 + 1/20922789888000*x^16 - 1/6402373705728000*x^1
  8 + 1/2432902008176640000*x^20 - 1/1124000727777607680000*x^22 + 1/6204484017
  33239439360000*x^24 - 1/403291461126605635584000000*x^26 + 1/3048883446117138
  60501504000000*x^28 - 1/265252859812191058636308480000000*x^30 + O(x^31)
-- Test sin^2 + cos^2 = 1
testEquals("1$R", "s1^2 + c1^2")
 

testcase "NMUnivariatePowerSeries - exp/log roundtrip"
 
   All user variables and function definitions have been cleared.
R := NUPS(NFRAC(NINT),'x,30,"capped_relative")
 

   (2)  NMUnivariatePowerSeries(NMFraction(NMInteger),x,30,:capped_relative)
x := x::R
 

   (3)  x + O(x^31)
p1 := x^2 + 3*x^5
 

   (4)  x^2 + 3*x^5 + O(x^32)
e1 := exp(p1)
 

   (5)
  1 + x^2 + 1/2*x^4 + 3*x^5 + 1/6*x^6 + 3*x^7 + 1/24*x^8 + 3/2*x^9 + 541/120*x^
  10 + 1/2*x^11 + 3241/720*x^12 + 1/8*x^13 + 11341/5040*x^14 + 181/40*x^15 + 30
  241/40320*x^16 + 1081/240*x^17 + 68041/362880*x^18 + 3781/1680*x^19 + 1238328
  1/3628800*x^20 + 10081/13440*x^21 + 134968681/39916800*x^22 + 22681/120960*x^
  23 + 808742881/479001600*x^24 + 2494801/1209600*x^25 + 500484883/889574400*x^
  26 + 27027001/13305600*x^27 + 12260528281/87178291200*x^28 + 161805601/159667
  200*x^29 + 1360800260821/1307674368000*x^30 + 700771501/2075673600*x^31 + O(x
  ^32)
l1 := log(e1)
 

   (6)  x^2 + 3*x^5 + O(x^32)
testEquals("0$R", "p1 - l1")
 

testcase "NMUnivariatePowerSeries - differentiation"
 
   All user variables and function definitions have been cleared.
R := NUPS(NFRAC(NINT),'x,30,"capped_relative")
 

   (2)  NMUnivariatePowerSeries(NMFraction(NMInteger),x,30,:capped_relative)
x := x::R
 

   (3)  x + O(x^31)
-- d/dx(x^2) = 2x
d1 := differentiate(x^2)
 

   (4)  2*x + O(x^31)
testEquals("0$R", "d1 - 2*x")
 

testcase "NMUnivariatePowerSeries - integration"
 
   All user variables and function definitions have been cleared.
R := NUPS(NFRAC(NINT),'x,30,"capped_relative")
 

   (2)  NMUnivariatePowerSeries(NMFraction(NMInteger),x,30,:capped_relative)
x := x::R
 

   (3)  x + O(x^31)
-- integral(x) = x^2/2
i1 := integrate(x)
 

   (4)  1/2*x^2 + O(x^32)
testEquals("0$R", "i1 - x^2/2")
 

testcase "NMUnivariateLaurentSeries - negative powers"
 
   All user variables and function definitions have been cleared.
R := NULS(NFRAC(NINT),'y,30)
 

   (2)  NMUnivariateLaurentSeries(NMFraction(NMInteger),y,30)
y := y::R
 

   (3)  y + O(y^31)
-- Test y^(-1) * y = 1
l1 := y^(-1)
 

   (4)  y^-1 + O(y^29)
testEquals("1$R", "l1 * y")
 

