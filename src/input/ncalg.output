 Type: XDistributedPolynomial(OrderedVariableList([x,y,z]),Fraction(Integer))

XDP_to_FDA(p) ==
    lt := listOfTerms(p)
    res : FDA := 0
    for t in lt repeat
        res := res + (t.c)::FDA*(t.k)::FDA
    res
 
                                                                   Type: Void

