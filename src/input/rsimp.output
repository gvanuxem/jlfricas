do_rsimp(ww, kk) ==
    rs := rsimp(ww^(1/kk))
    if rs case "failed" then
        print(message("rs case _"failed_"")$OutputForm)
        print(kk::OutputForm)
        print(ww::OutputForm)
        testTrue("false")
    else if ww - rs^kk ~= 0 then
        print(message("ww - rs^kk ~= 0")$OutputForm)
        print(kk::OutputForm)
        print(ww::OutputForm)
        testTrue("false")
    else
        testTrue("true")
 
                                                                   Type: Void

-- Root of degree 3 in base field
for k in [2, 3, 4, 6, 8, 9, 12] repeat
    w31a :=  11*(4 + 3^(1/3) + 3^(2/3))^k
    do_rsimp(w31a, k)
    w31b := 7*(3 + 5^(1/3) + 5^(2/3))^k
    do_rsimp(w31b, k)
    w31c := 5*(4 + 3*7^(1/3))^k
    do_rsimp(w31c, k)
 
   Compiling function do_rsimp with type (AlgebraicNumber, 
      PositiveInteger) -> Void 
                                                                   Type: Void

-- Root of degree 4 in base field
for k in 2..12 repeat
    kk := k
    aa := 3^(1/4)
    w41a :=  11*(4 + 2*aa + aa^2 - aa^3)^k
    do_rsimp(w41a, kk)
    aa := 5^(1/4)
    w41b := 7*(3 + 4*aa -2*aa^2 + aa^3)^k
    do_rsimp(w41b, k)
 
                                                                   Type: Void

