             ,1,2
                                                    Type: Expression(Integer)
f3:=D(f2,x)
 

   (7)
                                   ,,,       ,   3
     f      (x,y(x)) + f  (x,y(x))y   (x) + y (x) f      (x,y(x))
      ,1,1,1            ,2                         ,2,2,2
   + 
        ,   2                     ,
     3 y (x) f      (x,y(x)) + 3 y (x)f      (x,y(x))
              ,1,2,2                   ,1,1,2
   + 
         ,                                    ,,
     (3 y (x)f    (x,y(x)) + 3 f    (x,y(x)))y  (x)
              ,2,2              ,1,2
                                                    Type: Expression(Integer)
