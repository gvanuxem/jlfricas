         ,1,2
                                                    Type: Expression(Integer)
f1:=D(f(x,y(x)),x)
 

                                  ,
   (5)  f  (x,y(x)) + f  (x,y(x))y (x)
         ,1            ,2
                                                    Type: Expression(Integer)
f2:=D(f1,x)
 

   (6)
