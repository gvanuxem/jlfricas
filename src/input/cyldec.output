good_cell2a(c1 : Ct) : Boolean ==
    sp1 := samplePoint(c1)
    for c2 in cad repeat
        cp := projection(c2)
        samplePoint(cp) ~= sp1 => iterate
        pf := eval(p1, lvars, samplePoint(c2))
        rval := retract(pf)@Ran
        rval < 0 => return false
    return true
 
