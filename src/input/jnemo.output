testcase "NMFraction(NMInteger) retraction"
 
   All user variables and function definitions have been cleared.
nf1 := coerce(3/4)@NMFraction(NMInteger)
 

        3
   (2)  -
        4
res1 := retractIfCan(nf1)@Union(Fraction(Integer), "failed")
 

        3
   (3)  -
        4
testTrue("not (res1 case _"failed_")")
 
testEquals("res1::Fraction(Integer)", "3/4")
 
testEquals("retract(nf1)@Fraction(Integer)", "3/4")
 

nf2 := coerce(5)@NMFraction(NMInteger)
 

   (7)  5
res2 := retractIfCan(nf2)@Union(Fraction(Integer), "failed")
 

   (8)  5
testTrue("not (res2 case _"failed_")")
 
testEquals("res2::Fraction(Integer)", "5/1")
 
testEquals("retract(nf2)@Fraction(Integer)", "5/1")
 

