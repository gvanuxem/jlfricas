testcase "NMPadicInteger"
 
   All user variables and function definitions have been cleared.
zp7 := NMPadicInteger(7)
 

   (2)  NMPadicInteger(7)
x := 14::zp7
 

   (3)  2*7^1 + O(7^65)
y := 7::zp7
 

   (4)  7^1 + O(7^65)
z := x + y
 

   (5)  3*7^1 + O(7^65)
testEquals("liftZ(z)", "21")
 
testEquals("valuation(z)", "1")
 
testEquals("valuation(x * y)", "2")
 
