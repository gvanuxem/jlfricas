svd_tall := svd(a_svd_tall);
 

s_tall := diagonalMatrix(svd_tall.sv);
 

svd_prod_tall := svd_tall.U * s_tall * svd_tall.Vt;
 

testTrue("jlApprox?(a_svd_tall, svd_prod_tall)")
 

