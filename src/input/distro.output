pa:Distribution EXPR INT:=bernoulliDistribution01 a
 

          _
   (12)  [a]
                                      Type: Distribution(Expression(Integer))
pb:Distribution EXPR INT:=bernoulliDistribution01 b
 

          _
   (13)  [b]
