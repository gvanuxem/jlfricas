)set message time on
)set message type on

-------------------------------------------------------------------------------
-- ============================================================================
-- EXHAUSTIVE TEST SUITE FOR jlFriCAS PLOTTING (jplot.spad)
-- Tests every single plotting capability, overload, and styling function
-- across JLDrawFunctions (JDRAW) and JLPlotFunctions (JPLOT).
-- ============================================================================
-------------------------------------------------------------------------------

-------------------------------------------------------------------------------
-- 1. SYMBOLIC EXPRESSION API (JLDrawFunctions)
-------------------------------------------------------------------------------

-- 1.1 Standard 2D curves & overplotting
jlPlot(sin(x), x = -%pi..%pi)
jlPlot!(cos(x), x = -%pi..%pi)

-- 1.2 Multi-curve list plotting
jlPlot([sin(x), cos(x), sin(2*x)], x = -%pi..%pi)
jlPlot!([cos(2*x), sin(3*x)], x = -%pi..%pi)

-- 1.3 Polar plots & polar overplotting
jlPolar(1 + cos(t), t = 0..2*%pi)
jlPolar!(sin(2*t), t = 0..2*%pi)

-- 1.4 2D Parametric curves & overplotting
jlParametricPlot(cos(t)^3, sin(t)^3, t = 0..2*%pi)
jlParametricPlot!(sin(3*t), sin(4*t), t = 0..2*%pi)

-- 1.5 3D Parametric space curves & overplotting
jlParametricPlot(cos(t), sin(t), t/5, t = 0..4*%pi)
jlParametricPlot!(sin(t) + 2*sin(2*t), cos(t) - 2*cos(2*t), -sin(3*t), t = 0..2*%pi)

-- 1.6 2D Heatmaps & overplotting
jlHeatmap(sin(x)*cos(y), x = -3.0..3.0, y = -3.0..3.0)
jlHeatmap!(cos(x)*sin(y), x = -3.0..3.0, y = -3.0..3.0)

-- 1.7 2D Implicit curves: F(x, y) = 0
-- Folium of Descartes
jlImplicitPlot(x^3 + y^3 - 3*x*y, x = -3.0..3.0, y = -3.0..3.0)
-- Lemniscate of Bernoulli
jlImplicitPlot((x^2 + y^2)^2 - 2*(x^2 - y^2), x = -2.0..2.0, y = -2.0..2.0)

-- 1.8 2D Vector fields
-- Rotational vortex
jlVectorField(-y, x, x = -2.0..2.0, y = -2.0..2.0)
-- Saddle / Hyperbolic field
jlVectorField(x, -y, x = -2.0..2.0, y = -2.0..2.0)

-- 1.9 3D Surfaces, Wireframes, Contours & Filled Contours
jlSurface(sin(x)*cos(y), x = -5.0..5.0, y = -5.0..5.0)
jlSurface!(cos(x)*sin(y), x = -5.0..5.0, y = -5.0..5.0)

jlWireframe(sin(x)*cos(y), x = -5.0..5.0, y = -5.0..5.0)
jlWireframe!(cos(x)*sin(y), x = -5.0..5.0, y = -5.0..5.0)

jlContour(sin(x)*cos(y), x = -5.0..5.0, y = -5.0..5.0)
jlContour!(cos(x)*sin(y), x = -5.0..5.0, y = -5.0..5.0)

jlContourf(sin(x)*cos(y), x = -5.0..5.0, y = -5.0..5.0)
jlContourf!(cos(x)*sin(y), x = -5.0..5.0, y = -5.0..5.0)

jlPlot(sin(x)*cos(y), x = -3.0..3.0, y = -3.0..3.0)
jlPlot!(cos(x)*sin(y), x = -3.0..3.0, y = -3.0..3.0)


-------------------------------------------------------------------------------
-- 2. FUNCTIONAL API (JLPlotFunctions)
-------------------------------------------------------------------------------

-- Define test anonymous functions
f1D := (t : DoubleFloat) : DoubleFloat +-> sin(t)*exp(-t/5)
g1D := (t : DoubleFloat) : DoubleFloat +-> cos(t)*exp(-t/5)
f2D := (u : DoubleFloat, v : DoubleFloat) : DoubleFloat +-> sin(u)*cos(v)
g2D := (u : DoubleFloat, v : DoubleFloat) : DoubleFloat +-> cos(u)*sin(v)
f3D := (t : DoubleFloat) : DoubleFloat +-> t / 5.0

-- 2.1 1D Functional Plotting (all 8 overloads)
jlPlot(f1D, -5.0..5.0)
jlPlot(f1D, -5.0..5.0, 100)
jlPlot(f1D, -5.0..5.0, "Damped Sine")
jlPlot(f1D, -5.0..5.0, 100, "Damped Sine (100 pts)")
jlPlot!(g1D, -5.0..5.0)
jlPlot!(g1D, -5.0..5.0, 100)
jlPlot!(g1D, -5.0..5.0, "Damped Cosine")
jlPlot!(g1D, -5.0..5.0, 100, "Damped Cosine (100 pts)")

-- 2.2 2D Surface Functional Plotting (all 8 overloads)
jlSurface(f2D, -3.0..3.0, -3.0..3.0)
jlSurface(f2D, -3.0..3.0, -3.0..3.0, 40)
jlSurface(f2D, -3.0..3.0, -3.0..3.0, "Surface f(x,y)")
jlSurface(f2D, -3.0..3.0, -3.0..3.0, 40, "Surface f(x,y) (40x40)")
jlSurface!(g2D, -3.0..3.0, -3.0..3.0)
jlSurface!(g2D, -3.0..3.0, -3.0..3.0, 40)
jlSurface!(g2D, -3.0..3.0, -3.0..3.0, "Surface g(x,y)")
jlSurface!(g2D, -3.0..3.0, -3.0..3.0, 40, "Surface g(x,y) (40x40)")

-- 2.3 2D Wireframe Functional Plotting (all 8 overloads)
jlWireframe(f2D, -3.0..3.0, -3.0..3.0)
jlWireframe(f2D, -3.0..3.0, -3.0..3.0, 30)
jlWireframe(f2D, -3.0..3.0, -3.0..3.0, "Wireframe f")
jlWireframe(f2D, -3.0..3.0, -3.0..3.0, 30, "Wireframe f (30x30)")
jlWireframe!(g2D, -3.0..3.0, -3.0..3.0)
jlWireframe!(g2D, -3.0..3.0, -3.0..3.0, 30)
jlWireframe!(g2D, -3.0..3.0, -3.0..3.0, "Wireframe g")
jlWireframe!(g2D, -3.0..3.0, -3.0..3.0, 30, "Wireframe g (30x30)")

-- 2.4 2D Contour Functional Plotting (all 8 overloads)
jlContour(f2D, -3.0..3.0, -3.0..3.0)
jlContour(f2D, -3.0..3.0, -3.0..3.0, 50)
jlContour(f2D, -3.0..3.0, -3.0..3.0, "Contour f")
jlContour(f2D, -3.0..3.0, -3.0..3.0, 50, "Contour f (50x50)")
jlContour!(g2D, -3.0..3.0, -3.0..3.0)
jlContour!(g2D, -3.0..3.0, -3.0..3.0, 50)
jlContour!(g2D, -3.0..3.0, -3.0..3.0, "Contour g")
jlContour!(g2D, -3.0..3.0, -3.0..3.0, 50, "Contour g (50x50)")

-- 2.5 2D Filled Contour Functional Plotting (all 8 overloads)
jlContourf(f2D, -3.0..3.0, -3.0..3.0)
jlContourf(f2D, -3.0..3.0, -3.0..3.0, 50)
jlContourf(f2D, -3.0..3.0, -3.0..3.0, "Filled Contour f")
jlContourf(f2D, -3.0..3.0, -3.0..3.0, 50, "Filled Contour f (50x50)")
jlContourf!(g2D, -3.0..3.0, -3.0..3.0)
jlContourf!(g2D, -3.0..3.0, -3.0..3.0, 50)
jlContourf!(g2D, -3.0..3.0, -3.0..3.0, "Filled Contour g")
jlContourf!(g2D, -3.0..3.0, -3.0..3.0, 50, "Filled Contour g (50x50)")

-- 2.6 Heatmap Functional Plotting (all 8 overloads)
jlHeatmap(f2D, -3.0..3.0, -3.0..3.0)
jlHeatmap(f2D, -3.0..3.0, -3.0..3.0, 60)
jlHeatmap(f2D, -3.0..3.0, -3.0..3.0, "Heatmap f")
jlHeatmap(f2D, -3.0..3.0, -3.0..3.0, 60, "Heatmap f (60x60)")
jlHeatmap!(g2D, -3.0..3.0, -3.0..3.0)
jlHeatmap!(g2D, -3.0..3.0, -3.0..3.0, 60)
jlHeatmap!(g2D, -3.0..3.0, -3.0..3.0, "Heatmap g")
jlHeatmap!(g2D, -3.0..3.0, -3.0..3.0, 60, "Heatmap g (60x60)")

-- 2.7 2D Parametric Functional Plotting (all 8 overloads)
jlParametricPlot(f1D, g1D, 0.0..6.28)
jlParametricPlot(f1D, g1D, 0.0..6.28, 150)
jlParametricPlot(f1D, g1D, 0.0..6.28, "2D Parametric")
jlParametricPlot(f1D, g1D, 0.0..6.28, 150, "2D Parametric (150 pts)")
jlParametricPlot!(g1D, f1D, 0.0..6.28)
jlParametricPlot!(g1D, f1D, 0.0..6.28, 150)
jlParametricPlot!(g1D, f1D, 0.0..6.28, "2D Parametric Overplot")
jlParametricPlot!(g1D, f1D, 0.0..6.28, 150, "2D Parametric Overplot (150 pts)")

-- 2.8 3D Parametric Functional Plotting (all 8 overloads)
jlParametricPlot(f1D, g1D, f3D, 0.0..12.56)
jlParametricPlot(f1D, g1D, f3D, 0.0..12.56, 200)
jlParametricPlot(f1D, g1D, f3D, 0.0..12.56, "3D Space Curve")
jlParametricPlot(f1D, g1D, f3D, 0.0..12.56, 200, "3D Space Curve (200 pts)")
jlParametricPlot!(g1D, f1D, f3D, 0.0..12.56)
jlParametricPlot!(g1D, f1D, f3D, 0.0..12.56, 200)
jlParametricPlot!(g1D, f1D, f3D, 0.0..12.56, "3D Space Curve Overplot")
jlParametricPlot!(g1D, f1D, f3D, 0.0..12.56, 200, "3D Space Curve Overplot (200 pts)")

-- 2.9 Polar Functional Plotting (all 8 overloads)
jlPolar(f1D, 0.0..6.28)
jlPolar(f1D, 0.0..6.28, 120)
jlPolar(f1D, 0.0..6.28, "Polar Curve")
jlPolar(f1D, 0.0..6.28, 120, "Polar Curve (120 pts)")
jlPolar!(g1D, 0.0..6.28)
jlPolar!(g1D, 0.0..6.28, 120)
jlPolar!(g1D, 0.0..6.28, "Polar Curve Overplot")
jlPolar!(g1D, 0.0..6.28, 120, "Polar Curve Overplot (120 pts)")

-- 2.10 Implicit Functional Plotting (all 4 overloads)
jlImplicitPlot(f2D, -3.0..3.0, -3.0..3.0)
jlImplicitPlot(f2D, -3.0..3.0, -3.0..3.0, 70)
jlImplicitPlot(f2D, -3.0..3.0, -3.0..3.0, "Implicit Curve f=0")
jlImplicitPlot(f2D, -3.0..3.0, -3.0..3.0, 70, "Implicit Curve f=0 (70x70)")

-- 2.11 Vector Field Functional Plotting (all 4 overloads)
jlVectorField(f2D, g2D, -2.0..2.0, -2.0..2.0)
jlVectorField(f2D, g2D, -2.0..2.0, -2.0..2.0, 20)
jlVectorField(f2D, g2D, -2.0..2.0, -2.0..2.0, "Vector Field (f, g)")
jlVectorField(f2D, g2D, -2.0..2.0, -2.0..2.0, 20, "Vector Field (f, g) (20x20)")


-------------------------------------------------------------------------------
-- 3. DIRECT ARRAY AND MATRIX DATA APIS (JLPlotFunctions)
-------------------------------------------------------------------------------

pdf(x) ==> x pretend DoubleFloat

-- 3.1 Vector creation and 1D/3D array plots
vx := jlRange(-%pi..%pi, 100)
vy := map(x +-> coerce(sin(pdf(x)))@JF64, vx)
vz := map(x +-> coerce(cos(pdf(x)))@JF64, vx)

jlPlot(vx, vy)
jlPlot!(vx, vz)
jlPlot(vx, vy, vz)
jlPlot!(vx, vz, vy)

-- 3.2 Bar chart, Curves, and Density
jlBar(vx, vy)
jlBar!(vx, vz)
jlCurves(vx, vy)
jlCurves!(vx, vz)
jlDensity(vy)
jlDensity!(vz)

-- 3.3 2D Grid & Matrix plotting (Surface, Wireframe, Contour, Contourf, Heatmap)
nx : PositiveInteger := 40
ny : PositiveInteger := 40
xGrid := jlRange(-3.0..3.0, nx)
yGrid := jlRange(-3.0..3.0, ny)
zMat := qnew(nx, ny)$JF64MAT
for i in 1..nx repeat
  xi := pdf(qelt(xGrid, i))
  for j in 1..ny repeat
    yj := pdf(qelt(yGrid, j))
    qsetelt!(zMat, i, j, coerce(sin(xi)*cos(yj))@JF64)

jlSurface(xGrid, yGrid, zMat)
jlSurface!(xGrid, yGrid, zMat)

jlWireframe(xGrid, yGrid, zMat)
jlWireframe!(xGrid, yGrid, zMat)

jlContour(xGrid, yGrid, zMat)
jlContour!(xGrid, yGrid, zMat)

jlContourf(xGrid, yGrid, zMat)
jlContourf!(xGrid, yGrid, zMat)

jlHeatmap(xGrid, yGrid, zMat)
jlHeatmap!(xGrid, yGrid, zMat)


-------------------------------------------------------------------------------
-- 4. STYLING, RESOLUTION & FIGURE CONTROLS (JLPlotFunctions)
-------------------------------------------------------------------------------

-- 4.1 Window size & Rendering DPI
jlPlotSize!(800, 600)
jlPlotDpi!(150)

-- 4.2 Colormaps & Palettes
jlPlotColorMap!("plasma")
jlPlotColorMap!("viridis")
jlPlotColorMap!("inferno")
jlPlotColorMap!("turbo")
jlPlotColorMap!("coolwarm")

-- 4.3 Axis Scales
jlPlotXscale!("identity")
jlPlotYscale!("identity")

-- 4.4 Legends & Grids
jlPlotGrid!(false)
jlPlotGrid!(true)
jlPlotLegend!("bottomright")
jlPlotLegend!("topleft")
jlPlotLegend!("none")

-- 4.5 Labels and Range Limits
jlPlotTitle!("Exhaustive jlFriCAS Plotting Verification")
jlPlotXlabel!("X Axis")
jlPlotYlabel!("Y Axis")
jlPlotZlabel!("Z Axis")
jlPlotXlims!(-4.0, 4.0)
jlPlotYlims!(-4.0, 4.0)
jlPlotZlims!(-2.0, 2.0)

-- 4.6 Global sampling points configuration
p2d := jlPlotPoints()
p3d := jlPlot3dPoints()
jlSetPlotPoints!(350)
jlSetPlot3dPoints!(75)
jlSetPlotPoints!(p2d)
jlSetPlot3dPoints!(p3d)

-- 4.7 Backend Selection, File Export & Canvas Management
jlSetPlotsBackend!("gr")
jlPlot(sin(x), x = -%pi..%pi)
jlSavePlot("exhaustive_test_result.png")
jlClosePlots()
