testcase "Rational Arithmetic"
 
   All user variables and function definitions have been cleared.
                                                                   Type: Void
a := jrat(1, 3)$JLObjRational
 

   (2)  1/3
                                                          Type: JLObjRational
b := jrat(1, 6)$JLObjRational
 

   (3)  1/6
                                                          Type: JLObjRational
-- addition: 1/3 + 1/6 = 1/2
s := a + b
 

   (4)  1/2
                                                          Type: JLObjRational
testEquals("numerator s", "1")
 
                                                                   Type: Void
testEquals("denominator s", "2")
 
                                                                   Type: Void
-- subtraction: 1/3 - 1/6 = 1/6
d := a - b
 

   (7)  1/6
                                                          Type: JLObjRational
testEquals("numerator d", "1")
 
                                                                   Type: Void
testEquals("denominator d", "6")
 
                                                                   Type: Void
-- multiplication: 1/3 * 1/6 = 1/18
m := a * b
 

   (10)  1/18
                                                          Type: JLObjRational
testEquals("numerator m", "1")
 
                                                                   Type: Void
testEquals("denominator m", "18")
 
                                                                   Type: Void
-- division: (1/3) / (1/6) = 2
q := a / b
 

   (13)  2/1
                                                          Type: JLObjRational
testEquals("numerator q", "2")
 
                                                                   Type: Void
testEquals("denominator q", "1")
 
                                                                   Type: Void
