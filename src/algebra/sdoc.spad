)abbrev package SDOC SpadDoc
++ Author: G. Vanuxem
++ Date Created: march, 2026
++ Description: This package provides simple
++ Spad documentation for the interpreter and
++ the MCP server using BrowserInformation.
SpadDoc : Exports == Implementation where
  OPDOC     ==> Record(origin: String, signature: String, doc: String)
  CONREC    ==> Record(categories: List(Symbol), domains: List(Symbol), packages: List(Symbol))
  SEARCHOP  ==> Record(name: Symbol, origin: String, signature: String, doc: String)
  SEARCHRES ==> Record(constructors: CONREC, operations: List SEARCHOP)
  Exports ==> with
    operationDocumentation  : Symbol -> Void
    ++ operationDocumentation(op) displays the documentation of the
    ++ operation op.
    getOperationDocumentation : Symbol -> List OPDOC
    ++ getOperationDocumentation(op) returns a list of records containing
    ++ the origin constructor, signature, and documentation for operation op.
    constructorDocumentation  : Symbol -> Void
    ++ constructorDocumentation(term) displays the documentation of the
    ++ constructor term.
    getConstructorDocumentation : Symbol -> String
    ++ getConstructorDocumentation(term) returns the cleaned documentation
    ++ of constructor term.
    searchDocumentation : String -> Void
    ++ searchDocumentation(pat) searches for constructors and operations
    ++ whose documentation matches pat and displays the results.
    searchDocumentation : (String, Integer) -> Void
    ++ searchDocumentation(pat, max_ops) searches for constructors and operations
    ++ matching pat, displaying at most max_ops operations.
    searchDocumentation : Symbol -> Void
    ++ searchDocumentation(pat) searches for constructors and operations
    ++ whose documentation matches pat and displays the results.
    searchDocumentation : (Symbol, Integer) -> Void
    ++ searchDocumentation(pat, max_ops) searches for constructors and operations
    ++ matching pat, displaying at most max_ops operations.
    getSearchDocumentation : String -> SEARCHRES
    ++ getSearchDocumentation(pat) returns structured matching constructors
    ++ and operations with cleaned documentation and formatted signatures.
    getSearchDocumentation : Symbol -> SEARCHRES
    ++ getSearchDocumentation(pat) returns structured matching constructors
    ++ and operations with cleaned documentation and formatted signatures.
    listConstructors : Symbol -> Record(categories: List(Symbol), _
      domains: List(Symbol), packages: List(Symbol))
    ++ listConstructors(const) returns a list of the categories, domains,
    ++ and packages that the constructor const belongs to.
    ++ For example:
    ++ \example{listConstructors('AbelianMonoidRing)}
    ++ \example{listConstructors("Int*")}
    listCategories : Symbol -> List(Symbol)
    ++ listCategories(cat) returns a list of the categories matching
    ++ the categories cat.
    listDomains : Symbol -> List(Symbol)
    ++ listDomains(dom) returns a list of the domains matching
    ++ the domains dom.
    listPackages : Symbol -> List(Symbol)
    ++ listPackages(pack) returns a list of the packages matching
    ++ the packages pack.
  Implementation ==> add
    import from BrowserInformation

    extract_brace(s : String, pos : Integer) : _
        Record(text: String, next_pos: Integer) ==
      n := #s
      start := pos + 1
      count : Integer := 1
      i := start
      while i <= n and count > 0 repeat
        if s.i = char "\" then
          i := i + 2
        else if s.i = char "{" then
          count := count + 1
          i := i + 1
        else if s.i = char "}" then
          count := count - 1
          i := i + 1
        else
          i := i + 1
      if count > 0 then [s(start..n), n + 1]
      else [s(start..(i-2)), i]

    -- Recursive TeX cleaner
    clean_tex(s : String) : String ==
      n := #s
      res : String := ""
      i : Integer := 1
      while i <= n repeat
        c := s.i
        if c = char "\" then
          i := i + 1
          if i > n then
            res := concat(res, char(92)::String)
            i := n + 1
          else
            -- Try to find macro name
            start := i
            while i <= n and (alphabetic?(s.i) or s.i = char "&") repeat
              i := i + 1
            mac := s(start..(i-1))
            -- Handle macros
            if mac = "spad" or mac = "spadop" or _
               mac = "spadfun" or mac = "spadtype" or _
               mac = "url" or mac = "em" or _
               mac = "it" or mac = "bold" or _
               mac = "spadvar" or mac = "spadgloss" or _
               mac = "pspadfun" or mac = "spadsys" or _
               mac = "spadpaste" or mac = "spadcommand" or _
               mac = "footnote" then
              -- Extract argument in { }
              if i <= n and s.i = char "{" then
                arg_res := extract_brace(s, i)
                res := concat(res, clean_tex(elt(arg_res, text)))
                i := elt(arg_res, next_pos)
              else
                res := concat(res, mac)
            else if mac = "spadignore" then
              if i <= n and s.i = char "{" then
                arg_res := extract_brace(s, i)
                i := elt(arg_res, next_pos)
            else if mac = "example" then
              if i <= n and s.i = char "{" then
                arg_res := extract_brace(s, i)
                res := concat(res, concat [newline()::String, _
                  "Example: ", clean_tex(elt(arg_res, text)), newline()::String])
                i := elt(arg_res, next_pos)
            else if mac = "spadfunFrom" or _
                    mac = "spadopFrom" then
              if i <= n and s.i = char "{" then
                arg1 := extract_brace(s, i)
                i := elt(arg1, next_pos)
                if i <= n and s.i = char "{" then
                  arg2 := extract_brace(s, i)
                  res := concat(res, concat [clean_tex(elt(arg1, text)), _
                    " from ", clean_tex(elt(arg2, text))])
                  i := elt(arg2, next_pos)
                else
                  res := concat(res, clean_tex(elt(arg1, text)))
            else if mac = "indented" then
              if i <= n and s.i = char "{" then
                arg1 := extract_brace(s, i)
                i := elt(arg1, next_pos)
                if i <= n and s.i = char "{" then
                  arg2 := extract_brace(s, i)
                  res := concat(res, clean_tex(elt(arg2, text)))
                  i := elt(arg2, next_pos)
            else if mac = "newline" or _
                    mac = "blankline" then
              res := concat(res, newline())
            else if mac = "tab" then
              res := concat(res, "    ")
            else if mac = "space" then
              res := concat(res, " ")
            else if mac = "undocumented" then
              res := concat(res, "is undocumented")
            else if mac = "Language" then
              res := concat(res, "FriCAS")
            else if mac = "LaTeX" then
              res := concat(res, "LaTeX")
            else if mac = "TeX" then
              res := concat(res, "TeX")
            else if #mac = 0 then
              -- Escaped character like \{ \} \% \\
              if i <= n then
                res := concat(res, s.i::String)
                i := i + 1
            else
              if i <= n and s.i = char "{" then
                arg_res := extract_brace(s, i)
                res := concat(res, clean_tex(elt(arg_res, text)))
                i := elt(arg_res, next_pos)
              else
                res := concat(res, mac)
        else if c = char "{" or c = char "}" then
          i := i + 1
        else
          res := concat(res, c::String)
          i := i + 1
      res

    getConstructorDocumentation(term : Symbol) : String ==
      clean_tex(constructor_documentation(term))

    constructorDocumentation(term) ==
      doc := getConstructorDocumentation(term)
      doc = "" => void()
      sayBrightly$Lisp ""
      sayBrightly$Lisp doc
      void()

    format_signature(sig : SExpression) : String ==
      l : List SExpression := destruct(sig)
      empty?(l) => ""
      target : String := formString(first(l))$Lisp
      sources : List SExpression := rest(l)
      empty?(sources) => concat(["() -> ", target])
      #sources = 1 => concat([formString(first(sources))$Lisp, " -> ", target])
      src_strs : List String := [formString(s)$Lisp for s in sources]
      src_str : String := src_strs.1
      for s in rest(src_strs) repeat
        src_str := concat([src_str, ", ", s])
      concat(["(", src_str, ") -> ", target])

    match_case_sensitive?(pat : String, target : String) : Boolean ==
      pat = target => true
      pat = "*" => false
      position(char "*", pat) = 0 and position(char " ", pat) = 0 => false
      pu := parse_pattern(pat, false)$LogicalRegularExpressionMatch
      pu case "failed" => false
      do_match(pu::LogicalMatchingAutomaton, target)$LogicalMatchingAutomaton

    filter_syms_case_sensitive(pat : String, syms : List Symbol) : List Symbol ==
      [s for s in syms | match_case_sensitive?(pat, string(s))]

    getOperationDocumentation(op : Symbol) : List OPDOC ==
      pat := string op
      ops := search_operations(pat)
      ops case ErrorIndicator => []
      docs := (ops::List(Record(name: Symbol,
        sdl: List(Record(signature: SExpression,
          condition: SExpression, origin: SExpression,
            documentation: String)))))
      res_list : List OPDOC := []
      for ops_rec in docs repeat
        if match_case_sensitive?(pat, string(elt(ops_rec, name))) then
          for item in elt(ops_rec, sdl) repeat
            orig_str : String := formString(elt(item, origin))$Lisp
            sig_str : String := format_signature(elt(item, signature))
            doc_str : String := clean_tex(elt(item, documentation))
            res_list := concat(res_list, [orig_str, sig_str, doc_str]$OPDOC)
      res_list

    listOperationDocumentation(op : Symbol) : List(OutputForm) ==
      docs := getOperationDocumentation(op)
      res_list : List OutputForm := []
      for item in docs repeat
        res_list := concat(res_list, message(elt(item, doc)))
        res_list := concat(res_list, message(concat ["Signature: ", elt(item, signature)]))
        res_list := concat(res_list, message(concat ["From: ", elt(item, origin)]))
        res_list := concat(res_list, coerce newline())
      res_list

    operationDocumentation(op) ==
      docs := getOperationDocumentation(op)
      empty?(docs) => void()
      for item in docs repeat
        sayBrightly$Lisp ""
        sayBrightly$Lisp (elt(item, doc))
        sayBrightly$Lisp concat ["Signature: ", elt(item, signature)]
        sayBrightly$Lisp concat ["From: ", elt(item, origin)]
      void()
     
    listConstructors(const) ==
      pat := string(const)
      consts := search_constructors(pat, 'k)
      consts case ErrorIndicator => [[], [], []]
      res_rec := (consts::Record(categories: List(Symbol), _
        domains: List(Symbol), packages: List(Symbol)))
      [filter_syms_case_sensitive(pat, res_rec.categories), _
       filter_syms_case_sensitive(pat, res_rec.domains), _
       filter_syms_case_sensitive(pat, res_rec.packages)]
    listCategories(cat : Symbol) ==
      pat := string(cat)
      cats := search_constructors(pat, 'c)
      cats case ErrorIndicator => []
      res_rec := (cats::Record(categories: List(Symbol), _
        domains: List(Symbol), packages: List(Symbol)))
      filter_syms_case_sensitive(pat, res_rec.categories)
    listDomains(dom : Symbol) ==
      pat := string(dom)
      doms := search_constructors(pat, 'd)
      doms case ErrorIndicator => []
      res_rec := (doms::Record(categories: List(Symbol), _
        domains: List(Symbol), packages: List(Symbol)))
      filter_syms_case_sensitive(pat, res_rec.domains)
    listPackages(pack : Symbol) ==
      pat := string(pack)
      packs := search_constructors(pat, 'p)
      packs case ErrorIndicator => []
      res_rec := (packs::Record(categories: List(Symbol), _
        domains: List(Symbol), packages: List(Symbol)))
      filter_syms_case_sensitive(pat, res_rec.packages)

    int_to_string(n : Integer) : String ==
      string(formString(n::OutputForm)$Lisp)

    format_symbol_list(l : List Symbol) : String ==
      empty?(l) => ""
      res : String := string first(l)
      for s in rest(l) repeat
        res := concat([res, ", ", string(s)])
      res

    normalize_doc_pattern(pat : String) : String ==
      words := split(pat, char " ")
      empty?(words) => ""
      #words = 1 => first(words)
      res : String := ""
      need_op : Boolean := false
      for w in words repeat
        if w = "and" or w = "or" then
          res := concat([res, " ", w])
          need_op := false
        else if w = "not" then
          if need_op then
            res := concat([res, " and not"])
          else if res = "" then
            res := "not"
          else
            res := concat([res, " not"])
          need_op := false
        else
          wt : String :=
            w.1 = char("*") or w(#w) = char("*") or w.1 = char("(") or w(#w) = char(")") => w
            concat(["*", w, "*"])
          if need_op then
            res := concat([res, " and ", wt])
          else if res = "" then
            res := wt
          else
            res := concat([res, " ", wt])
          need_op := true
      res

    getSearchDocumentation(pat : String) : SEARCHRES ==
      empty_con : CONREC := [[], [], []]
      empty_res : SEARCHRES := [empty_con, []]
      pat = "" => empty_res
      norm_pat := normalize_doc_pattern(pat)
      norm_pat = "" => empty_res
      s_res := search_documentation(norm_pat)$BrowserInformation
      if s_res case ErrorIndicator then
        s_res := search_documentation(pat)$BrowserInformation
      s_res case ErrorIndicator => empty_res
      gen_rec := (s_res::Record(con_info: CONREC, _
        op_info: List(Record(name: Symbol, _
          sdl: List(Record(signature: SExpression, condition: SExpression, _
                           origin: SExpression, documentation: String))))))
      con_rec : CONREC := elt(gen_rec, con_info)
      op_list : List SEARCHOP := []
      for ops_rec in elt(gen_rec, op_info) repeat
        op_name := elt(ops_rec, name)
        for item in elt(ops_rec, sdl) repeat
          orig_str : String := formString(elt(item, origin))$Lisp
          sig_str : String := format_signature(elt(item, signature))
          doc_str : String := clean_tex(elt(item, documentation))
          op_list := concat(op_list, [op_name, orig_str, sig_str, doc_str]$SEARCHOP)
      [con_rec, op_list]

    getSearchDocumentation(pat : Symbol) : SEARCHRES ==
      getSearchDocumentation(string pat)

    searchDocumentation(pat : String, max_ops : Integer) : Void ==
      s_res := getSearchDocumentation(pat)
      con := elt(s_res, constructors)
      ops := elt(s_res, operations)
      cats := elt(con, categories)
      doms := elt(con, domains)
      packs := elt(con, packages)
      num_con := #cats + #doms + #packs
      num_ops := #ops
      num_con = 0 and num_ops = 0 =>
        sayBrightly$Lisp concat ["No documentation found matching: ", pat]
        void()
      sayBrightly$Lisp concat ["=== Documentation Search: ", pat, " ==="]
      if num_con > 0 then
        sayBrightly$Lisp ""
        sayBrightly$Lisp "Constructors:"
        if not empty?(cats) then
          sayBrightly$Lisp concat ["  Categories: ", format_symbol_list(cats)]
        if not empty?(doms) then
          sayBrightly$Lisp concat ["  Domains:    ", format_symbol_list(doms)]
        if not empty?(packs) then
          sayBrightly$Lisp concat ["  Packages:   ", format_symbol_list(packs)]
      if num_ops > 0 then
        sayBrightly$Lisp ""
        sayBrightly$Lisp concat ["Operations (", int_to_string(num_ops), " match(es)):"]
        count : Integer := 0
        for item in ops repeat
          if max_ops > 0 and count >= max_ops then
            sayBrightly$Lisp ""
            sayBrightly$Lisp concat ["... and ", int_to_string(num_ops - count), " more operation(s)."]
            break
          else
            sayBrightly$Lisp ""
            sayBrightly$Lisp concat ["* ", string(elt(item, name)), " : ", elt(item, signature)]
            sayBrightly$Lisp concat ["  From: ", elt(item, origin)]
            if elt(item, doc) ~= "" then
              sayBrightly$Lisp concat ["  ", elt(item, doc)]
            count := count + 1
      void()

    searchDocumentation(pat : String) : Void ==
      searchDocumentation(pat, 25)

    searchDocumentation(pat : Symbol) : Void ==
      searchDocumentation(string pat, 25)

    searchDocumentation(pat : Symbol, max_ops : Integer) : Void ==
      searchDocumentation(string pat, max_ops)

