)abbrev category WSO WSObject
++ Category for Julia WS objects
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic Object category using the Wolfram Symbol
++  Transport Protocol.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSObject() : Category == JLObjectType() with
    jWSInterpret : String -> %
    ++ jWSInterpret(form) interprets form.
    -- For later use. See WS call in ?? Spad code (WSEXPR)
    jWSInterpret : (String, String) -> %
    ++ jWSInterpret(Type|Form, Expr) interprets Expr to be of type Type or Form
    ++ using the Wolfram Symbolic Language.
    ++ For example:
    ++ \example{jWSInterpret("Number","3.2")@WSREAL}
    ++ \example{jWSInterpret("Real","3.2")@WSREAL}
    ++ \example{jWSInterpret("Location","Lille")$WSEXPR}
    ++ See jWSExpression "\$InterpreterTypes"
    jWSInterpret : (String, String, String) -> %
    ++ jWSInterpret(form1,form2,form3) interprets forms.
    jlEval  : % -> %
    ++ jlEval(expr) evaluates expr using the Wolfram Symbolic Transport Protocol.
    jlSymbolic : % -> String
    ++ jlSymbolic(expr) returns the symbolic 'FullForm'.
    numeric : % -> WSExpression
    ++ numeric(expr) returns numerical expr if possible.
    numeric : (%, PositiveInteger) -> WSExpression
    ++ numeric(expr, prec) returns the numerical expr with prec digits of precision
    ++ if possible.
    numeric? : % -> Boolean
    ++ numeric?(x) checks whether or not x is or would yield a number.
    jlHead   : % -> WSSymbol
    ++ jlHead(expr) returns the Head type of expr.
    toString : % -> String
    ++ toString(obj) returns the string representation of obj.
    string : % -> String
    ++ string(obj) returns the string representation of obj in
    ++ the Julia WS format.
    coerce : % -> WSExpression
    ++ coerce(expr) returns the WSExpression representation of expr.
    jlWSEval : (String, %) -> WSExpression
    ++ jlWSEval(func, x) evaluates the Wolfram function func on x.
    jlWSEval : (String, %, %) -> WSExpression
    ++ jlWSEval(func, x, y) evaluates the Wolfram function func on x and y.
    jlWSEval : (String, %, %, %) -> WSExpression
    ++ jlWSEval(func, x, y, z) evaluates the Wolfram function func on x, y, and z.
    jlWSEval : (String, %, %, %, %) -> WSExpression
    ++ jlWSEval(func, a, b, c, d) evaluates the Wolfram function func on 4 arguments.
    jlWSEval : (String, %, %, %, %, %) -> WSExpression
    ++ jlWSEval(func, a, b, c, d, e) evaluates the Wolfram function func on 5 arguments.
    jlWSEval : (String, List %) -> WSExpression
    ++ jlWSEval(func, list) evaluates the Wolfram function func on a list of arguments.
    jlWSApply : (String, %) -> WSExpression
    ++ jlWSApply(sym, x) creates an unevaluated Wolfram expression sym[x].
    jlWSApply : (String, %, %) -> WSExpression
    ++ jlWSApply(sym, x, y) creates an unevaluated Wolfram expression sym[x, y].
    jlWSApply : (String, %, %, %) -> WSExpression
    ++ jlWSApply(sym, x, y, z) creates an unevaluated Wolfram expression sym[x, y, z].
    jlWSApply : (String, %, %, %, %) -> WSExpression
    ++ jlWSApply(sym, a, b, c, d) creates an unevaluated Wolfram expression on 4 arguments.
    jlWSApply : (String, %, %, %, %, %) -> WSExpression
    ++ jlWSApply(sym, a, b, c, d, e) creates an unevaluated Wolfram expression on 5 arguments.
    jlWSApply : (String, List %) -> WSExpression
    ++ jlWSApply(sym, list) creates an unevaluated Wolfram expression sym[list...].
  add
    import from JLUtilityFunctions
    import from String
    jlInitialize(true)

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."

    jlEvalString("Interpret=W_`Interpreter_`")@Void

    getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
    junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
    jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
    jlWSEval(func : String, a : %) : WSExpression == make_jlref_weval1(func, a)$Lisp
    jlWSEval(func : String, a : %, b : %) : WSExpression == make_jlref_weval2(func, a, b)$Lisp
    jlWSEval(func : String, a : %, b : %, c : %) : WSExpression == make_jlref_weval3(func, a, b, c)$Lisp
    jlWSEval(func : String, a : %, b : %, c : %, d : %) : WSExpression ==
      make_jlref_weval4(func, a, b, c, d)$Lisp
    jlWSEval(func : String, a : %, b : %, c : %, d : %, e : %) : WSExpression ==
      make_jlref_weval5(func, a, b, c, d, e)$Lisp
    jlWSEval(func : String, l : List %) : WSExpression ==
      agg := jlref("W_`{}_`")
      for x in l repeat agg := make_jlref_weval2("Append", agg, x)$Lisp
      make_jlref_weval_list(func, agg)$Lisp

    jlWSApply(sym : String, a : %) : WSExpression == make_jlref_wapply1(sym, a)$Lisp
    jlWSApply(sym : String, a : %, b : %) : WSExpression == make_jlref_wapply2(sym, a, b)$Lisp
    jlWSApply(sym : String, a : %, b : %, c : %) : WSExpression == make_jlref_wapply3(sym, a, b, c)$Lisp
    jlWSApply(sym : String, a : %, b : %, c : %, d : %) : WSExpression ==
      make_jlref_wapply4(sym, a, b, c, d)$Lisp
    jlWSApply(sym : String, a : %, b : %, c : %, d : %, e : %) : WSExpression ==
      make_jlref_wapply5(sym, a, b, c, d, e)$Lisp
    jlWSApply(sym : String, l : List %) : WSExpression ==
      agg := jlref("W_`{}_`")
      for x in l repeat agg := make_jlref_weval2("Append", agg, x)$Lisp
      make_jlref_wapply_list(sym, agg)$Lisp

    jlApply(sym, arg) == make_jlref_wapply1(sym, arg)$Lisp
    jlApply(sym, a, b) == make_jlref_wapply2(sym, a, b)$Lisp
    jlApply(sym, a, b, c) == make_jlref_wapply3(sym, a, b, c)$Lisp
    jlApply(sym, a, b, c, d) == make_jlref_wapply4(sym, a, b, c, d)$Lisp
    jlApply(sym, a, b, c, d, e) == make_jlref_wapply5(sym, a, b, c, d, e)$Lisp

    jlSymbolic(jwso) ==
      -- subject to change
      jlEvalString(concat(["weval(W_"ToString_"(W_"FullForm_"(",
        getind(jwso),")))"]))
    toString(jwso) ==
      jlEvalString(concat(["weval(W_"ToString_"(W_"OutputForm_"(",
        getind(jwso),")))"]))
    jlHead(jwso) == junfunc("Head", jwso)
    jlEval(jwso) == make_jlref_wcall1("weval", jwso)$Lisp
    jWSInterpret(form) ==
      jlref(concat ["Interpret(_"", form, "_")"])
    jWSInterpret(form, form1) ==
      jlref(concat ["Interpret(_"", form, "_",)(_"", form1, "_")"])
    jWSInterpret(form, form1, form2) ==
      jlref(concat ["Interpret(_"", form, "_",)(_"",
        form1, "_",)(_"", form2, "_")"])
    numeric(expr) == junfunc("N", expr)
    numeric(expr, p) ==
      prec := jlref(concat(["WInteger(_"", string(p), "_")"]))
      jbinfunc("N", expr, prec)
    coerce(expr : %) == expr pretend WSExpression
    numeric?(expr : %) == numeric?(coerce expr)$WSExpression

)abbrev category WSRING WSRing
++ Category for Julia WS rings
++ Author: G. Vanuxem
++ Date Created: Jun, 2024
++ Description:
++  Julia Wolfram Symbolic category for rings using the Wolfram Symbol
++  Transport Protocol.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSRing() : Category == Join(WSObject, JLObjectRing)

)abbrev category WSNUM WSNumber
++ Category for Julia WS numbers
++ Author: G. Vanuxem
++ Date Created: Jun, 2024
++ Description:
++  Julia Wolfram Symbolic category for numbers using the Wolfram Symbol
++  Transport Protocol.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSNumber() : Category == WSRing

)abbrev domain WSSYM WSSymbol
++ Generic domain for Julia WS symbols
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic symbols using the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSSymbol() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinbop(op,a,b) ==>
    jlEvalString(concat([getind(a), op, getind(b)]))@Boolean
  Exports ==> WSObject with
    WReal     : () -> %
    ++ WReal() returns the WS Real symbol.
    WComplex  : () -> %
    ++ WComplex() returns the WS Complex symbol.
    WRational : () -> %
    ++ WRational() returns the WS Rational symbol.
    WInteger  : () -> %
    ++ WInteger() returns the WS Integer symbol.
    WTrue     : () -> %
    ++ WTrue() returns the WS True symbol.
    WFalse    : () -> %
    ++ WFalse() returns the WS False symbol.
    WFailure  : () -> %
    ++ WFailure() returns the WS Failure symbol.
    WRule    : () -> %
    ++ WRule() returns the WS Rule symbol.
    WList    : () -> %
    ++ WList() returns the WS List symbol.
    WString    : () -> %
    ++ WString() returns the WS String symbol.
    WSymbol    : () -> %
    ++ WSymbol() returns the WS Symbol symbol.
    WMissing  : () -> %
    ++ WMissing() returns the WS Missing symbol.
    WNone     : () -> %
    ++ WNone() returns the WS None symbol.
    WFormat   : () -> %
    ++ WFormat() returns the WS Format symbol.
    coerce  : % -> Boolean
    ++ coerce(sym) coerces sym to a FriCAS Boolean.
    ++ Sym must be a Julia WS boolean
    coerce : Boolean -> %
    ++ coerce(bool) coerces bool to a Julia WS boolean.
    coerce : String -> %
    ++ coerce(str) is a convenience function to coerce a String.
    coerce : Symbol -> %
    ++ coerce(sym) is a convenience function to coerce a Symbol.
    coerce : % -> Symbol
    ++ coerce(sym) is a convenience function to coerce sym
    ++ to a FriCAS Symbol.
    jWSSym : Symbol -> %
    ++ jWSSym(sym) constructs sym as a WSSymbol.
    jWSSym : String -> %
    ++ jWSSym(str) constructs str as a WSSymbol.
    elt : (%, WSExpression) -> WSExpression
    ++ elt(sym, x) applies the symbol sym to x, evaluating it.
    elt : (%, WSExpression, WSExpression) -> WSExpression
    ++ elt(sym, x, y) applies the symbol sym to x and y, evaluating it.
    elt : (%, WSExpression, WSExpression, WSExpression) -> WSExpression
    ++ elt(sym, x, y, z) applies the symbol sym to x, y, and z, evaluating it.
    elt : (%, WSExpression, WSExpression, WSExpression, WSExpression) -> WSExpression
    ++ elt(sym, a, b, c, d) applies the symbol sym to 4 arguments, evaluating it.
    elt : (%, WSExpression, WSExpression, WSExpression, WSExpression, WSExpression) -> WSExpression
    ++ elt(sym, a, b, c, d, e) applies the symbol sym to 5 arguments, evaluating it.
    elt : (%, List WSExpression) -> WSExpression
    ++ elt(sym, list) applies the symbol sym to a list of arguments, evaluating it.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from String
    jlInitialize(true)

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."
    jlEvalString("import MathLink: WSymbol")

    x = y  == jbinbop("==", x, y)
    x ~= y == jbinbop("!=", x, y)

    WReal()     == jlref("WSymbol(_"Real_")")
    WComplex()  == jlref("WSymbol(_"Complex_")")
    WRational() == jlref("WSymbol(_"Rational_")")
    WInteger()  == jlref("WSymbol(_"Integer_")")
    WTrue()     == jlref("WSymbol(_"True_")")
    WFalse()    == jlref("WSymbol(_"False_")")
    WRule()     == jlref("WSymbol(_"Rule_")")
    WList()     == jlref("WSymbol(_"List_")")
    WString()   == jlref("WSymbol(_"String_")")
    WSymbol()   == jlref("WSymbol(_"Symbol_")")
    WFailure()  == jlref("WSymbol(_"Failure_")")
    WMissing()  == jlref("WSymbol(_"Missing_")")
    WNone()     == jlref("WSymbol(_"None_")")
    WFormat()   == jlref("WSymbol(_"Format_")")

    coerce(bool : Boolean) ==
      bool => WTrue()
      WFalse()
    coerce(sym : %) : Boolean == sym = WTrue()
    coerce(sym : %) : Symbol  == coerce(string(sym))
    coerce(sym : Symbol) == jlref(concat(["WSymbol(_"", string(sym), "_")"]))
    coerce(str : String) == jlref(concat(["W_`", str, "_`"]))
    jWSSym(sym : Symbol) == jlref(concat(["WSymbol(_"", string(sym), "_")"]))
    jWSSym(str : String) == jlref(concat(["W_`", str, "_`"]))
    coerce(obj) : OutputForm == jl_string_getindex(jlId(obj))$Lisp

    elt(sym : %, x : WSExpression) : WSExpression ==
      make_jlref_weval1(string(sym), x)$Lisp
    elt(sym : %, x : WSExpression, y : WSExpression) : WSExpression ==
      make_jlref_weval2(string(sym), x, y)$Lisp
    elt(sym : %, x : WSExpression, y : WSExpression, z : WSExpression) : WSExpression ==
      make_jlref_weval3(string(sym), x, y, z)$Lisp
    elt(sym : %, a : WSExpression, b : WSExpression, c : WSExpression, d : WSExpression) : WSExpression ==
      make_jlref_weval4(string(sym), a, b, c, d)$Lisp
    elt(sym : %, a : WSExpression, b : WSExpression, c : WSExpression, d : WSExpression, e : WSExpression) : WSExpression ==
      make_jlref_weval5(string(sym), a, b, c, d, e)$Lisp
    elt(sym : %, l : List WSExpression) : WSExpression ==
      agg := jlref("W_`{}_`")
      for x in l repeat agg := make_jlref_weval2("Append", agg, x)$Lisp
      make_jlref_weval_list(string(sym), agg)$Lisp

)abbrev domain WSSTR WSString
++ Generic domain for Julia WS strings
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic strings using the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSString() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  Exports ==> WSObject with
    characters : % -> WSList(%)
    ++ characters(str) returns the characters of str as a WSList.
    elt : (%, Integer) -> %
    ++ elt(str,i) returns the i-th character of str.
    coerce  : % -> String
    ++ coerce(str) coerces str to a FriCAS String.
    ++ str must be a Julia WS string
    coerce : String -> %
    ++ coerce(str) coerces str to a Julia WS string.
    jWSString : String -> %
    ++ jWSString(str) constructs str as a WSString.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from String
    jlInitialize(true)

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."

    x = y  == jbinbop("==", x, y)
    x ~= y == jbinbop("!=", x, y)

    elt(obj,i) == characters(obj).i
    characters(str : %) : WSList(%) == junfunc("Characters", str)
    coerce(str : String) : % == jWSString(str)
    coerce(str : %) : String == jl_string_getindex(jlId(obj))$Lisp
    coerce(str : %) : WSExpression == str pretend WSExpression
    jWSString(str) == jlref(concat(["W_`_"", str, "_"_`"]))
    coerce(obj) : OutputForm ==
      coerce(jl_string_getindex(jlId(obj))$Lisp pretend String)

)abbrev domain WSINT WSInteger
++ Generic domain for Julia WS integers
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic integers using the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSInteger() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jterfunc(func,a,b,c) ==> make_jlref_weval3(func, a, b, c)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  parsei ==> PARSE_-INTEGER$Lisp
  Exports ==> Join(WSNumber, IntegerNumberSystem,
                  Canonical, canonicalsClosed) with
    integer : % -> Integer
    ++ integer(i) returns i as a FriCAS Integer.
    hyperFactorial : % -> %
    ++ hyperFactorial(n) computes the hyperfactorial of n.
    qFactorial : (%, %) -> %
    ++ qFactorial(x,q) returns the q-analog of factorial of x.
    fibonacci : % -> %
    ++ fibonacci(n) returns the Fibonacci number Fn.
    stirling1 : (%, %) -> %
    ++ stirling1(n,m) returns the Stirling number of the first kind
    ++ from n and m. For example:
    ++ \example{stirling1(20, jWSInteger 2)}
    stirling2 : (%, %) -> %
    ++ stirling2(n,m) returns the Stirling number of the second kind
    ++ from n and m. For example:
    ++ \example{stirling2(20, jWSInteger 2)}
    factor : % -> WSList WSList(%)
    ++ factor(n) returns the WS factorization of n.
    coerce  : Integer  -> %
    ++ coerce(z) coerces z.
    coerce  : % -> WSRational
    ++ coerce(z) coerces z.
    jWSInteger : Integer -> %
    ++ jWSInteger(int) constructs int as a WSInteger.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from String
    jlInitialize(true)

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."
    jlEvalString("import MathLink: WInteger")@Void

    0 == jlref("WInteger(_"0_")")
    1 == jlref("WInteger(_"1_")")
    WT : WSSymbol := WTrue()

    zero? x == x = 0
    one? x == x = 1

    negative? x == junfunc("Negative", x) = WT
    positive? x == junfunc("Positive", x) = WT

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    x < y  == jbinfunc("Less", x,y) = WT
    x > y  == jbinfunc("Greater", x,y) = WT
    x >= y == jbinfunc("GreaterEqual", x,y) = WT
    x <= y == jbinfunc("LessEqual", x,y) = WT

    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : Integer * y : % == jbinop("*", coerce(x), y)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)
    x quo y == jbinfunc("Quotient", x, y)
    x rem y == jbinfunc("Mod", x, y)
    powmod(x,y,z) == jterfunc("PowerMod", x, y, z)
    divide(x, y) ==
      zero?(y) => error "divide$WSInteger: division by 0"
      ret : WSList(%) := jbinfunc("QuotientRemainder", x, y)
      [first(ret) pretend %, last(ret) pretend %]

    gcd(a,b) == jbinfunc("GCD", a, b)
    lcm(a,b) == jbinfunc("LCM", a, b)

    length(i) == junfunc("BitLength", i)
    shift(i,n) == jbinfunc("BitShiftLeft", i, n)

    factorial(n)      == junfunc("Factorial", n)
    binomial(n,m)     == jbinfunc("Binomial", n, m)
    hyperFactorial(n) == junfunc("Hyperfactorial", n)
    qFactorial(z,q)   == jbinfunc("qFactorial", z,q)
    fibonacci(n)      == junfunc("Fibonacci", n)
    permutation(n,m)  == permutation(n, m)$IntegerCombinatoricFunctions(%)
    -- TODO: length for FriCAS factor function
    -- makeFR()$factored(%)
    stirling1(n,m) == jbinfunc("StirlingS1", n, m)
    stirling2(n,m) == jbinfunc("StirlingS2", n, m)
    -- TODO: factor jWSInteger 70421676397833365421106577172389167104000000000000
    factor(n) : Factored(%) ==
      error "factor is not implemented for WSInteger, use factor@WSList(WSList(WSInteger)) or factorInteger$WSExpression instead" 
    factor(n) : WSList WSList(%) == junfunc("FactorInteger", n)

    prime?(z) == junfunc("PrimeQ", z) = WT

    random(n) == junfunc("RandomInteger",n)
    integer(i) == parsei(string i)
    convert(i : %) : Integer == parsei(string i)
    coerce(x : %) : WSRational ==
      jlref(concat(getind(x), "/1"))$WSRational
    coerce(x : %) : WSExpression == x pretend WSExpression
    coerce(i : Integer) == jlref(concat(["WInteger(_"", string(i), "_")"]))
    jWSInteger(i : Integer) == jlref(concat(["WInteger(_"", string(i), "_")"]))
    -- TODO
    coerce(i) : OutputForm ==
      ret : String := jl_string_getindex(jlId i)$Lisp
      coerce(parsei(ret))$Integer

)abbrev domain WSRAT WSRational
++ Generic domain for Julia WS rational numbers
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic rational numbers using the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSRational() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  parsei ==> PARSE_-INTEGER$Lisp
  Exports ==> Join(WSNumber,
      QuotientFieldCategory(WSInteger)) with
    coerce  : Integer  -> %
    ++ coerce(z) coerces z. Convenience function.
    "/"     : (WSInteger, WSInteger) -> %
    ++ a/b returns the Julia WS rational a/b.
    -- TODO:
    ++ Beware of erroneous interpreter coercions.
    convert : % -> Fraction(Integer)
    ++ convert(q) returns q as a Fraction(Integer).
    jWSRational : Fraction(Integer) -> %
    ++ jWSRational(q) constructs q as a WSRational.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from String
    jlInitialize(true)

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."
    jlEvalString("WRAT=W_"Rational_"")@Void

    0 == jlref("WRAT(0,1)")
    1 == jlref("WRAT(1,1)")
    WT : WSSymbol := WTrue()

    zero? x == x = 0
    one? x  == x = 1

    negative? x == junfunc("Negative", x) = WT
    positive? x == junfunc("Positive", x) = WT

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    x < y  == jbinfunc("Less", x,y) = WT
    x > y  == jbinfunc("Greater", x,y) = WT
    x >= y == jbinfunc("GreaterEqual", x,y) = WT
    x <= y == jbinfunc("LessEqual", x,y) = WT

    numer(x) == junfunc("Numerator" , x)
    denom(x) == junfunc("Denominator" , x)
    numerator(x) ==
      jlref(concat(["WRAT(", string(junfunc("Numerator" , x)), ",1)("]))
    denominator(x) ==
      jlref(concat(["WRAT(", string(junfunc("Denominator" , x)), ",1)("]))

    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : % * y : Fraction(Integer) == jbinop("*", x, coerce(y)@WSRational)
    x : WSInteger * y : % == jbinop("/", x, y)
    x : Integer * y : % == jbinop("*", coerce(x), y)
    x : % / y : % == jbinop("//", x, y)
    x : WSInteger / y : WSInteger == jbinop("//", x, y)
    x : % ^ y : Integer == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)

    string(q) == toString q
    convert(q) : String == toString q
    retract(q : %) : WSInteger ==
      denom(q) = 1 => numer(q)
      error("retract@WSInteger: not an integer")
    retractIfCan(x : %) : Union(WSInteger, "failed") ==
      denom(x) = 1 => numer(x)
      "failed"
    retract(q : %) : Fraction(Integer) ==
      n : Integer := parsei(toString(junfunc("Numerator" , q)))
      d : Integer := parsei(toString(junfunc("Denominator" , q)))
      n / d
    retractIfCan(x : %) : Union(Fraction(Integer), "failed") ==
      n : Integer := parsei(toString(junfunc("Numerator" , x)))
      d : Integer := parsei(toString(junfunc("Denominator" , x)))
      n / d

    numeric(x: %) == numeric(x pretend WSExpression)
    numeric(x: %, n : PositiveInteger) ==
      numeric(x pretend WSExpression, n)

    coerce(i : Integer) == jlref(concat(["WRAT(", string(i), ",1)"]))
    coerce(x : %) : WSExpression == x pretend WSExpression
    jWSRational(rat : Fraction Integer) : % ==
      jlref(concat(["WRAT(", string(numer(rat)), "," ,string(denom(rat)), ")"]))

    convert(x : %) : Fraction(Integer) ==
      numer : Integer := parsei(toString(junfunc("Numerator" , x)))
      denom : Integer := parsei(toString(junfunc("Denominator" , x)))
      numer / denom
    coerce(x) : OutputForm ==
      numer : Integer := parsei(toString(junfunc("Numerator" , x)))
      denom : Integer := parsei(toString(junfunc("Denominator" , x)))
      denom = 1 => outputForm(numer)
      (outputForm numer)  / (outputForm denom)
      --concat([toString(numer),"/", toString(denom)]) pretend OutputForm

)abbrev domain WSREAL WSReal
++ Generic domain for WS real numbers
++ Author: G. Vanuxem
++ Date Created: April, 2024
++ Description:
++  Julia Wolfram Symbolic real numbers using
++  the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSReal() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  Exports ==> Join(WSNumber, FloatingPointSystem,
                    DifferentialRing, ElementaryFunctionCategory,
                    TranscendentalFunctionCategory,
                    LiouvillianFunctionCategory) with
    urand01 : () -> %
    ++ urand01() returns a uniformly distributed random number in the range 0..1.
    integerPart : % -> WSInteger
    ++ integerPart(x) returns the integer part of x.
    jlApprox?: (%, %) -> Boolean
    ++ jlApprox?(x,y) computes inexact equality comparison
    ++ with WS default parameters (Equal).
    exp    : () -> %
    ++ exp() returns the WSAPReal ℯ (%e or exp(1)).
    sinc    : % -> %
    ++ sinc(x) computes the unnormalized sinc of x, sin(x)/x.
    log2    : % -> %
    ++ log2(x) computes the logarithm of x in base 2.
    log10   : % -> %
    ++ log10(x) computes the logarithm of x in base 10.
    atan    : (%, %) -> %
    ++ atan(x,y) computes the arc tangent of y/x.
    erf     : (%, %) -> %
    ++ erf(x) computes the error function of x.
    erfc    : % -> %
    ++ erfc(x) computes the complementary error function of x.
    rationalApproximation : % -> WSRational
    ++ rationalApproximation(x) tries to find a rational approximation
    ++ of x. Error if x can not be retracted.
    rationalApproximation : (%, %) -> WSRational
    ++ rationalApproximation(x, dx) returns a rational approximation
    ++ of x within tolerance dx. If dx = 0, converts it anyway.
    coerce : % -> DoubleFloat
    ++ coerce(r) coerces r to a DoubleFloat.
    coerce : % -> JLFloat64
    ++ coerce(r) coerces r to a JLFloat64.
    coerce  : % -> JLFloat
    ++ coerce(x) converts x to a JLFloat.
    coerce  : String -> %
    ++ coerce(str) constructs str as a WSReal.
    coerce  : JLFloat64  -> %
    ++ coerce(x) converts x to a WSReal.
    coerce  : DoubleFloat  -> %
    ++ coerce(x) converts x to a WSReal.
    coerce  : Float  -> %
    ++ coerce(x) converts x to a WSReal.
    coerce  : JLFloat  -> %
    ++ coerce(x) converts x to a WSReal.
    jWSReal : DoubleFloat -> %
    ++ jWSReal(z) coerces z to a WSReal.
    jWSReal : Float -> %
    ++ jWSReal(z) coerces z to a WSReal.
    jWSReal : JLFloat64 -> %
    ++ jWSReal(z) coerces z to a WSReal.
    jWSReal : Integer -> %
    ++ jWSReal(z) coerces the integer z to a WSReal.
    jWSReal : String -> %
    ++ jWSReal(str) constructs str as a WSReal.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from String
    import from WSExpression
    jlInitialize(true)

    error1(msg, f) ==> error concat [msg, " ", toString f]

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."
    jlEvalString("import MathLink: WReal")@Void

    -- Internal threshold precision
    -- iprec := jWSReal("1.e-15")

    0     == jlref("WReal(_"0_")")
    1     == jlref("WReal(_"1_")")
    pi()  == jWSExpression("N[Pi]")$WSExpression pretend %
    exp() == jWSExpression("N[E]")$WSExpression pretend %
    WT : WSSymbol := WTrue()
    --catalan()
    --goldenRatio()
    -- ...

    precision() == 53

    zero? x == zero?(x pretend WSExpression)
    one? x  == x = 1

    negative? x == junfunc("Negative", x) = WT
    positive? x == junfunc("Positive", x) = WT

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    x < y  == jbinfunc("Less", x,y) = WT
    x > y  == jbinfunc("Greater", x,y) = WT
    x >= y == jbinfunc("GreaterEqual", x,y) = WT
    x <= y == jbinfunc("LessEqual", x,y) = WT
    jlApprox?(x,y) == jbinfunc("Equal", x,y) = WT

    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : Integer * y : % == jbinop("*", coerce(x)@WSInteger, y)
    x : % / y : % == jbinop("/", x, y)
    x : % / y : Integer == jbinop("/", x, coerce(y)@WSInteger)
    x : % ^ y : % == jbinop("^", x, y)
    x : % ^ y : Integer == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)

    round(x)   == junfunc("Round", x)
    ceiling(x) == junfunc("Ceiling", x)
    floor(x)   == junfunc("Floor", x)
    abs(x)     == junfunc("RealAbs", x)

    rationalApproximation(x) ==
      ret : WSRational := junfunc("Rationalize", x)
      jlHead ret = WRational() => ret
      error concat(string(x), " cannot be retracted. Use a tolerance value if needed.")
    rationalApproximation(x, dx) ==
      ret : WSRational := jbinfunc("Rationalize", x, dx)
      jlHead ret = WRational() => ret
      error1("Cannot be retracted with tolerance: ", dx)

    float(m, e, b) == jbinop("*",jWSReal(m), jWSReal(b) ^ e)
    integerPart(x) == junfunc("IntegerPart",x)
    wholePart(x) == convert(junfunc("IntegerPart",x))$WSInteger
    fractionPart(x) == junfunc("FractionalPart", x)
    truncate(x)  == (negative? x => -floor(-x); floor x)
    retractIfCan(x : %):Union(Integer, "failed") ==
      zero? fractionPart(x) => wholePart(x)
      "failed"
    retract(x : %) : Integer ==
      zero? fractionPart(x) => wholePart(x)
      error1("retract: not an integer",x)
    retract(x:%) : Fraction Integer ==
      convert(rationalApproximation(x))
    retractIfCan(x:%):Union(Fraction Integer, "failed") ==
      convert(rationalApproximation(x))

    exp(x)   == junfunc("Exp",x)
    sqrt(x)  ==
      negative? x => error1("sqrt: result is not real for argument",x)
      junfunc("Sqrt",x)
    log(x)   ==
      zero?(x) => error1("log2: invalid argument",x)
      not positive?(x) => error1("log: result is not real for argument",x)
      junfunc("Log",x)
    log2(x)  ==
      zero?(x) => error1("log2: invalid argument",x)
      not positive?(x) => error1("log2: result is not real for argument",x)
      junfunc("Log2",x)
    log10(x) ==
      zero?(x) => error1("log10: invalid argument",x)
      not positive?(x) => error1("log10: result is not real for argument",x)
      junfunc("Log10",x)

    sin(x) == junfunc("Sin",x)
    cos(x) == junfunc("Cos",x)
    tan(x) == junfunc("Tan",x)
    sec(x) == junfunc("Sec",x)
    csc(x) == junfunc("Csc",x)
    cot(x) == junfunc("Cot",x)
    sinc(x)== junfunc("Sinc",x)

    asin(x)   ==
      abs(x) <= 1 => junfunc("ArcSin",x)
      error1("asin: result is not real for argument", x)
    acos(x)   ==
      abs(x) <= 1 => junfunc("ArcCos",x)
      error1("acos: result is not real for argument", x)
    atan(x)   == junfunc("ArcTan",x)
    atan(x,y) == jbinfunc("ArcTan",x, y)
    asec(x)   ==
      abs(x) <= 1 => error1("asec: result is not real for argument", x)
      junfunc("ArcSec",x)
    acsc(x)   ==
      zero?(x) => error1("acsc: not defined for argument", x)
      abs(x) <= 1 => error1("acsc: result is not real for argument", x)
      junfunc("ArcCsc",x)
    acot(x)   == junfunc("ArcCot",x)

    sinh(x) == junfunc("Sinh",x)
    cosh(x) == junfunc("Cosh",x)
    tanh(x) == junfunc("Tanh",x)
    sech(x) == junfunc("Sech",x)
    csch(x) == junfunc("Csch",x)
    coth(x) == junfunc("Coth",x)

    asinh(x) == junfunc("ArcSinh",x)
    acosh(x) ==
      if x < 1 then error1("acosh: result is not real for argument", x)
      junfunc("ArcCosh",x)
    atanh(x) ==
      if abs(x) > 1 then error1("atanh: result is not real for argument", x)
      junfunc("ArcTanh",x)
    asech(x) ==
      if x <= 0 or x > 1 then
          error1("asech: branch cut or singularity detected for argument", x)
      junfunc("ArcSech",x)
    acsch(x) ==
      if zero? x then error1("acsch: not defined for argument", x)
      junfunc("ArcCsch",x)
    acoth(x) ==
      if abs(x) <= 1 then
          error1("acoth: branch cut or singularity detected for argument", x)
      junfunc("ArcCoth",x)

    erf(x)      == junfunc("Erf",x)
    erfc(x)     == junfunc("Erfc",x)
    erf(x, y)   == jbinfunc("Erf",x, y)
    erfi(x)     == junfunc("Erfi",x)

    Si(x)       == junfunc("SinIntegral",x)
    Shi(x)      == junfunc("SinhIntegral",x)
    Ci(x)       == junfunc("CosIntegral",x)
    Chi(x)      == junfunc("CoshIntegral",x)
    Ei(x)       == junfunc("ExpIntegralEi",x)
    fresnelC(x) == junfunc("FresnelC",x)
    fresnelS(x) == junfunc("FresnelS",x)
    li(x)       == junfunc("LogIntegral",x)
    dilog(x)    == jbinfunc("PolyLog", coerce(2)@WSInteger, x)
    differentiate x == 0

    urand01() == jlEval(jWSExpression("RandomReal[]")) pretend %

    toString(x, p : NonNegativeInteger) ==
      n := # string integerPart x
      jlEvalString(concat(["weval(W_"ToString_"(W_"NumberForm_"(",
        getind(x),",", string(p+n), ")))"]))

    coerce(r : %) : DoubleFloat ==
      jlEvalString(getind(jlEval r))@JLFloat64 pretend DoubleFloat
    coerce(r : %) : JLFloat64 == jlEvalString(getind(jlEval r))
    coerce(x : %) : WSExpression == x pretend WSExpression
    coerce(x) : JLFloat ==
      jlref(concat(["weval(BigFloat,", getind(x),")"]))$JLFloat

    coerce(str : String) : % ==
      x := jlref(concat(["WReal(_"", str, "_")"]))
      machineNumber?(x pretend WSExpression) => x
      error "jWSReal: Not a machine number"
    coerce(f : Float) ==
      tmp := outputSpacing(0)
      try
        ret : % := jlref(concat(["WReal(_"", toString(f), "_")"]))
        machineNumber?(ret pretend WSExpression) => ret
        error "jWSReal: Not a machine number"
      finally
        outputSpacing(tmp)
    coerce(f : JLFloat64) == jlref(concat(["WReal(_"", toString(f), "_")"]))
    coerce(f : DoubleFloat) == jlref(concat(["WReal(_"", toString(f), "_")"]))
    coerce(f : JLFloat) ==
      x := jlref(concat(["WReal(_"", string(f), "_")"]))
      machineNumber?(x pretend WSExpression) => x
      error "jWSReal: Not a machine number"
    coerce(f : Integer) == jlref(concat(["WReal(_"", string(f), "_")"]))
    jWSReal(f : JLFloat64) == jlref(concat(["WReal(_"", toString(f), "_")"]))
    jWSReal(f : DoubleFloat) == jlref(concat(["WReal(_"", toString(f), "_")"]))
    jWSReal(f : Float) ==
      tmp := outputSpacing(0)
      try
        ret := jlref(concat(["WReal(_"", toString(f), "_")"]))
        machineNumber?(ret pretend WSExpression) => ret
        error "jWSReal: Not a machine number"
      finally
        outputSpacing(tmp)
    jWSReal(f : Integer) == jlref(concat(["WReal(_"", string(f), "_")"]))
    jWSReal(str) ==
      x:= jlref(concat(["WReal(_"", str, "_")"]))
      machineNumber?(x pretend WSExpression) => x
      error "jWSReal: Not a machine number"
    coerce(x) : OutputForm ==
      x >= 0 => jl_string_getindex(jlId(x))$Lisp
      - jl_string_getindex(jlId(abs x))$Lisp

)abbrev domain WSAPR WSAPReal
++ Generic domain for Julia WS arbitrary precision real numbers
++ Author: G. Vanuxem
++ Date Created: April, 2024
++ Description:
++  Julia Wolfram Symbolic arbitrary precision real numbers using
++  Wolfram Symbolic Transport Protocol.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSAPReal(prec : PositiveInteger) : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  Exports ==> Join(WSNumber, FloatingPointSystem, arbitraryPrecision,
                    DifferentialRing, ElementaryFunctionCategory,
                    TranscendentalFunctionCategory,
                    LiouvillianFunctionCategory) with
    urand01 : () -> %
    ++ urand01() returns a uniformly distributed random number in the range 0..1.
    integerPart : % -> WSInteger
    ++ integerPart(x) returns the integer part of x.
    jlApprox?: (%, %) -> Boolean
    ++ jlApprox?(x,y) computes inexact equality comparison
    ++ with WS default parameters (Equal).
    exp    : () -> %
    ++ exp() returns the WSAPReal ℯ (%e or exp(1)).
    sinc    : % -> %
    ++ sinc(x) computes the unnormalized sinc of x, sin(x)/x and 0 if x = 0.
    log2    : % -> %
    ++ log2(x) computes the logarithm of x in base 2.
    log10   : % -> %
    ++ log10(x) computes the logarithm of x in base 10.
    atan    : (%, %) -> %
    ++ atan(x,y) computes the arc tangent of y/x.
    erf     : (%, %) -> %
    ++ erf(x) computes the error function of x.
    erfc    : % -> %
    ++ erfc(x) computes the complementary error function of x.
    rationalApproximation : % -> WSRational
    ++ rationalApproximation(x) tries to find a rational approximation
    ++ of x.
    rationalApproximation : (%, %) -> WSRational
    ++ rationalApproximation(x, dx) tries to find a rational approximation
    ++ of x within tolerance dx.
    coerce  : % -> JLFloat
    ++ coerce(x) converts x as a JLFloat.
    coerce  : String -> %
    ++ coerce(str) constructs str as a WSAPReal.
    coerce  : Float  -> %
    ++ coerce(x) converts x as a WSAPReal.
    coerce  : JLFloat  -> %
    ++ coerce(x) converts x as a WSAPReal.
    jWSReal : Integer -> %
    ++ jWSReal(i) coerces i to a WSAPReal.
    jWSReal : DoubleFloat -> %
    ++ jWSReal(f) coerces f to a WSAPReal.
    jWSReal : JLFloat64 -> %
    ++ jWSReal(f) coerces f to a WSAPReal.
    jWSReal : Float -> %
    ++ jWSReal(f) coerces f to a WSAPReal.
    jWSReal : JLFloat -> %
    ++ jWSReal(f) coerces f to a WSAPReal.
    jWSReal : String -> %
    ++ jWSReal(str) constructs str as a WSAPReal.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from String
    import from WSExpression
    jlInitialize(true)

    jtypeassert(a) ==> jlHead(a) ~= WReal()
        => error "Type of output does not match input type"
    error1(msg, f) ==> error(concat [msg, " ", toString(f)])

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."

    jlEvalString("NN=W_`Interpreter[_"Real_"]_`")@Void

    0    == jlref(concat(["W_`N[0,", string(prec), "]_`"]))
    1    == jlref(concat(["W_`N[1,", string(prec), "]_`"]))
    WT : WSSymbol := WTrue()

    pi()  ==
      jWSExpression(concat(["N[Pi,", string(prec),"]"]))$WSExpression pretend %
    exp() ==
      jWSExpression(concat(["N[E,", string(prec),"]"]))$WSExpression pretend %

    -- redefine constructors?
    -- string, floats...
    -- Workaround an issue?
    zero? x == zero?(x pretend WSExpression)
    one? x  == zero?((x pretend WSExpression)-1)

    negative? x == junfunc("Negative", x) = WT
    positive? x == junfunc("Positive", x) = WT

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    x < y  == jbinfunc("Less", x,y) = WT
    x > y  == jbinfunc("Greater", x,y) = WT
    x >= y == jbinfunc("GreaterEqual", x,y) = WT
    x <= y == jbinfunc("LessEqual", x,y) = WT
    jlApprox?(x,y) == jbinfunc("Equal", x,y) = WT

    precision() == prec

    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : Integer * y : % == jbinop("*", coerce(x)@WSInteger, y)
    x : % / y : % == jbinop("/", x, y)
    x : % / y : Integer == jbinop("/", x, coerce(y)@WSInteger)
    x : % ^ y : % ==
      jtypeassert(res:=jbinop("^", x, y)) -- -3.2^-7.0
      res
    x : % ^ y : Integer == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)

    round(x)   == junfunc("Round", x)
    ceiling(x) == junfunc("Ceiling", x)
    floor(x)   == junfunc("Floor", x)
    abs(x)     == junfunc("RealAbs", x)
    float(m, e, b) == jbinop("*", jWSReal(m), jWSReal(b) ^ e)

    rationalApproximation(x) == junfunc("Rationalize", x)
    rationalApproximation(x, dx) == jbinfunc("Rationalize", x, dx)
    integerPart(x) == junfunc("IntegerPart",x)
    wholePart(x) == convert(junfunc("IntegerPart",x))$WSInteger
    fractionPart(x) == junfunc("FractionalPart", x)
    truncate(x) == (negative? x => -floor(-x); floor x)
    retractIfCan(x : %):Union(Integer, "failed") ==
      zero? fractionPart(x) => wholePart(x)
      "failed"
    retract(x : %) : Integer ==
      zero? fractionPart(x) => wholePart(x)
      error1("retract: not an integer", x)
    retract(x:%) : Fraction Integer ==
      convert(rationalApproximation(x))
    retractIfCan(x:%):Union(Fraction Integer, "failed") ==
      convert(rationalApproximation(x))

    exp(x)   == junfunc("Exp",x)
    sqrt(x)  ==
      negative? x => error1("sqrt: result is not real for argument",x)
      junfunc("Sqrt",x)
    log(x)   ==
      zero?(x) => error1("log2: invalid argument",x)
      not positive?(x) => error1("log: result is not real for argument",x)
      junfunc("Log",x)
    log2(x)  ==
      zero?(x) => error1("log2: invalid argument",x)
      not positive?(x) => error1("log2: result is not real for argument",x)
      junfunc("Log2",x)
    log10(x) ==
      zero?(x) => error1("log10: invalid argument",x)
      not positive?(x) => error1("log10: result is not real for argument",x)
      junfunc("Log10",x)

    sin(x) == junfunc("Sin",x)
    cos(x) == junfunc("Cos",x)
    tan(x) == junfunc("Tan",x)
    sec(x) == junfunc("Sec",x)
    csc(x) == junfunc("Csc",x)
    cot(x) == junfunc("Cot",x)
    sinc(x)== junfunc("Sinc",x)

    asin(x)   ==
      abs(x) <= 1 => junfunc("ArcSin",x)
      error1("asin: result is not real for argument", x)
    acos(x)   ==
      abs(x) <= 1 => junfunc("ArcCos",x)
      error1("acos: result is not real for argument", x)
    atan(x)   == junfunc("ArcTan",x)
    atan(x,y) == jbinfunc("ArcTan",x, y)
    asec(x)   ==
      abs(x) <= 1 => error1("asec: result is not real for argument", x)
      junfunc("ArcSec",x)
    acsc(x)   ==
      zero?(x) => error1("acsc: not defined for argument", x)
      abs(x) <= 1 => error1("acsc: result is not real for argument", x)
      junfunc("ArcCsc",x)
    acot(x)   == junfunc("ArcCot",x)

    sinh(x) == junfunc("Sinh",x)
    cosh(x) == junfunc("Cosh",x)
    tanh(x) == junfunc("Tanh",x)
    sech(x) == junfunc("Sech",x)
    csch(x) == junfunc("Csch",x)
    coth(x) == junfunc("Coth",x)

    asinh(x) == junfunc("ArcSinh",x)
    acosh(x) ==
      x < 1 => error1("acosh: result is not real for argument", x)
      junfunc("ArcCosh",x)
    atanh(x) ==
      if abs(x) >= 1 then error1("atanh: result is not real for argument", x)
      junfunc("ArcTanh",x)
    asech(x) ==
      one? x => 0
      if (x < 0 or x > 1) then error1("asech: result is not real for argument", x)
      junfunc("ArcSech",x)
    acsch(x) ==
      if zero? x then error1("acsch: not defined for argument", x)
      junfunc("ArcCsch",x)
    acoth(x) ==
      if abs(x) <= 1 then
        error1("acoth: branch cut or singularity detected for argument", x)
      junfunc("ArcCoth",x)

    erf(x)      == junfunc("Erf",x)
    erfc(x)     == junfunc("Erfc",x)
    erf(x, y)   == jbinfunc("Erf",x, y)
    erfi(x)     == junfunc("Erfi",x)
    Si(x)       == junfunc("SinIntegral",x)
    Shi(x)       == junfunc("SinhIntegral",x)
    Ci(x)       == junfunc("CosIntegral",x)
    Chi(x)      == junfunc("CoshIntegral",x)
    Ei(x)       == junfunc("ExpIntegralEi",x)
    fresnelC(x) == junfunc("FresnelC",x)
    fresnelS(x) == junfunc("FresnelS",x)
    li(x)       == junfunc("LogIntegral",x)
    dilog(x)    == jbinfunc("PolyLog", coerce(2)@WSInteger, x)
    differentiate x == 0

    urand01() ==
      jlEval jWSExpression(concat(["RandomReal[WorkingPrecision->",
        string(prec pretend Integer),"]"])) pretend %
    string(x) : String ==
      toString(x pretend WSExpression, jWSExpression("OutputForm"))
    convert(obj) : String == string obj
    toString(x) ==
      str := toString(x pretend WSExpression)
      str := jlEvalString(concat(["replace(_"", str,
        "_", _"*^_" => _" E _", r_"`[0-9]+\.?[0-9]*_" => _"_")"]))
      --jlRegexReplace(str, jlRegex("`.*\*\^"),
      --  jlSubstitute("e"))
    toString(x, p) ==
      toString(x pretend WSReal, p)

    coerce(x : %) : WSExpression == x pretend WSExpression
    coerce(x : %) : JLFloat ==
      jlref(concat(["weval(BigFloat,", getind(x),")"]))$JLFloat
    coerce(str : String) : % ==
      str = "0" => 0
      jlref(concat(["weval(NN(_"", str, "_`", string(prec), "_"))"]))
    coerce(f : Float) ==
      tmp := outputSpacing(0)
      try
        jlref(concat(["weval(NN(_"", convert(f)@String,
          "_`", string(prec),"_"))"]))
      finally
        outputSpacing(tmp)
    coerce(f : JLFloat) ==
      jlref(concat(["weval(NN(_"", toString(f), "_`", string(prec), "_"))"]))
    coerce(i : Integer) ==
      zero? i => 0
      jlref(concat(["weval(NN(_"", string(i), "_`", string(prec), "_"))"]))
    jWSReal(str) ==
      -- 0 is very special
      str = "0" => 0
      jlref(concat(["weval(NN(_"", str, "_`", string(prec), "_"))"]))
    jWSReal(i : Integer) ==
      zero? i => 0
      jlref(concat(["weval(NN(_"", string(i), "_`", string(prec), "_"))"]))
    jWSReal(f : JLFloat) ==
      jlref(concat(["weval(NN(_"", toString(f), "_`", string(prec), "_"))"]))
    jWSReal(f : DoubleFloat) ==
      jlref(concat(["weval(NN(_"", toString(f), "_`", string(prec), "_"))"]))
    jWSReal(f : JLFloat64) ==
      jlref(concat(["weval(NN(_"", toString(f), "_`", string(prec), "_"))"]))
    jWSReal(f : Float) ==
      tmp := outputSpacing(0)
      try
        jlref(concat(["weval(NN(_"", toString(f), "_`", string(prec), "_"))"]))
      finally
        outputSpacing(tmp)
    coerce(x) : OutputForm ==
      x >= 0 => coerce(x pretend WSExpression)
      - coerce(abs(x) pretend WSExpression)


)abbrev domain WSGINT WSGaussianInteger
++ Generic domain for Julia WS gaussian integers
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic gaussian integers using the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSGaussianInteger() : Exports == Implementation where
  parsei ==> PARSE_-INTEGER$Lisp
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  Exports ==> Join(WSNumber, ComplexCategory(WSInteger)) with
    random   : WSInteger -> %
    ++ random(n) returns a gaussian integer where real part is in the range 0..n
    ++ as the imaginary part.
    coerce   : Integer  -> %
    ++ coerce(x): convenience function.
    jWSGI    : (WSInteger, WSInteger) -> %
    ++ jWSGI(re, im) constructs a WSGaussianInteger from real
    ++ part re and imaginary part im.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    jlInitialize(true)

    bool(a) ==> coerce(a)$WSSymbol

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."

    0 == complex(0, 0)
    1 == complex(1, 0)
    imaginary()  == jlref("weval(im)")

    zero? x == x = 0
    one? x  == x = 1

    real(x)      == junfunc("Re", x)
    imag(x)      == junfunc("Im", x)

    conjugate(x) == junfunc("Conjugate", x)
    -- norm(z) in FriCAS = re(z)^2+im(z)^2 even for Complex(Float)
    -- Let FriCAS compute it
    --norm(x)      == junfunc("Norm", x)

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : Integer * y : % == jbinop("*", coerce(x)@WSInteger, y)
    x : WSInteger * y : % == jbinop("*", coerce(x), y)
    x : Integer * y : % == jbinop("*", coerce(x), y)
    x : % ^ y : Integer == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)

    unitNormal x ==
      -- TODO: improve
      zero? x => [1, x, 1]
      one? x => [1, 1, 1]
      re := real(x); im := imag(x)
      zero? re and im > 0 => [imaginary(), complex(im,0), -imaginary()]
      re > 0 =>
        im >= 0 => [1, x, 1]
        im < 0 => [-imaginary(), complex(-im, re), imaginary()]
      im < 0 => [-1, complex(-re, -im) ,-1]
      [imaginary(), complex(im, -re), -imaginary()]

    random(n) == complex(junfunc("RandomInteger",n) pretend WSInteger,
      junfunc("RandomInteger",n) pretend WSInteger)
    string(gi) == toString(gi)
    convert(obj) : String == string obj
    coerce(x : %) : WSExpression == x pretend WSExpression
    coerce(i : Integer) == complex(coerce(i)@WSInteger, 0)
    coerce(i : WSInteger) == complex(i, 0)
    complex(re : WSInteger, im : WSInteger) : % ==
      jbinfunc("Complex", re, im)
    jWSGI(re : WSInteger, im : WSInteger) : % ==
      jbinfunc("Complex", re, im)
    coerce(x) : OutputForm == message(toString(x))
      -- Too expensive
      -- re := (r := real x)::OutputForm
      -- ie := (i := imag x)::OutputForm
      -- zero? i => re
      -- outi := '%i::OutputForm
      -- ip :=
      --   (i = 1) => outi
      --   ((-i) = 1) => -outi
      --   ie * outi
      -- zero? r => ip
      -- re + ip

)abbrev domain WSCPLX WSComplex
++ Generic domain for Julia WS complex numbers
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic complex numbers using the MathLink Julia package.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSComplex() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  Exports ==> Join(WSNumber, ComplexCategory(WSReal),
                ElementaryFunctionCategory, TranscendentalFunctionCategory,
                LiouvillianFunctionCategory) with
    urand01 : () -> %
    ++ urand01() returns a unit square random complex number.
    "*"      : (WSInteger, %) -> %
    ++ n * x multiplies n by x.
    jlApprox?: (%, %) -> Boolean
    ++ jlApprox?(x,y) computes inexact equality comparison
    ++ with WS default parameters (Equal).
    exp     : () -> %
    ++ exp() returns the WSComplex ℯ (%e or exp(1)).
    sinc    : % -> %
    ++ sinc(z) computes the unnormalized sinc of z, sin(z)/z and 0 if z = 0.
    log2    : % -> %
    ++ log2(z) computes the logarithm of z in base 2.
    log10   : % -> %
    ++ log10(z) computes the logarithm of z in base 10.
    atan    : (%, %) -> %
    ++ atan(z1,z2) computes the arc tangent of z2/z1.
    erf     : (%, %) -> %
    ++ erf(x) is the error function.
    erfc    : % -> %
    ++ erfc(x) is the complementary error function.
    toString : (%, WSExpression) -> String
    ++ toString(expr, form) returns the string representation of expr
    ++ with WS language format form.
    coerce   : % -> Complex(DoubleFloat)
    ++ coerce(z) coerces z to a FriCAS Complex(DoubleFloat).
    coerce   : % -> Complex(JLFloat64)
    ++ coerce(z) coerces z to a FriCAS Complex(JLFloat64).
    coerce   : Integer  -> %
    ++ coerce(int): coerces int. Convenience function.
    coerce   : Complex(Integer) -> %
    ++ coerce(z) coerce z. Convenience function. -- %i operations for example
    coerce   : WSInteger  -> %
    ++ coerce(int): coerces int. Convenience function.
    complex    : (WSReal, WSReal) -> %
    ++ complex(re,im) constructs a WSComplex from real part re
    ++ and imaginary part im.
    jWSComplex    : WSReal -> %
    ++ jWSComplex(re) constructs a WSComplex with real part re.
    jWSComplex    : (WSReal, WSReal) -> %
    ++ jWSComplex(re, im) constructs a WSComplex from real part re
    ++ and imaginary part im.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from WSExpression
    jlInitialize(true)

    error1(msg, f) ==> error concat [msg, " ", toString f]
    bool(a) ==> coerce(a)$WSSymbol

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."

    0 == jlref(concat(["W_`Complex[0.0,0.0]_`"]))
    1 == jlref(concat(["W_`Complex[1.0,0.0]_`"]))
    imaginary()  == jlref(concat(["W_`Complex[0.0,1.0]_`"]))
    WT : WSSymbol := WTrue()

    zero? z == z = 0
    one? z  == z = 1

    pi()  == jlref(concat(["W_`Complex[Pi,0.0]_`"]))
    exp() == jlref(concat(["W_`Complex[E,0.0]_`"]))

    real(z)      == junfunc("Re", z)
    imag(z)      == junfunc("Im", z)

    conjugate(z) == junfunc("Conjugate", z)
    -- norm(z) in FriCAS = re(z)^2+im(z)^2 even for Complex(Float)
    -- Let FriCAS compute it
    --norm(x)      == junfunc("Norm", x)

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    jlApprox?(x,y) == jbinfunc("Equal", x,y) = WT
    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : WSInteger * y : % == jbinop("*", coerce(x), y)
    x : Integer * y : % == jbinop("*", coerce(x), y)
    x : % ^ y : Integer == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)

    unitNormal x ==
      -- TODO: to be improved
      zero? x => [1, x, 1]
      one? x => [1, 1, 1]
      re := real(x); im := imag(x)
      zero? re and im > 0 => [imaginary(), complex(im,0), -imaginary()]
      re > 0 =>
        im >= 0 => [1, x, 1]
        im < 0 => [-imaginary(), complex(-im, re), imaginary()]
      im < 0 => [-1, complex(-re, -im) ,-1]
      [imaginary(), complex(im, -re), -imaginary()]

    abs(z)     == junfunc("Abs", z)
    argument(z)  == junfunc("Arg", z)

    exp(z)   == junfunc("Exp",z)
    sqrt(z)  == junfunc("Sqrt",z)
    log(z)   ==
      zero? z  => error "log: 0 is an invalid argument"
      junfunc("Log",z)
    log2(z)  ==
      zero? z => error "log2: 0 is an invalid argument"
      junfunc("Log2",z)
    log10(z) ==
      zero? z => error "log10: 0 is an invalid argument"
      junfunc("Log10",z)

    sin(z) == junfunc("Sin",z)
    cos(z) == junfunc("Cos",z)
    tan(z) == junfunc("Tan",z)
    sec(z) == junfunc("Sec",z)
    csc(z) == junfunc("Csc",z)
    cot(z) == junfunc("Cot",z)

    sinc(z)== junfunc("Sinc",z)

    asin(z)   == junfunc("ArcSin",z)
    acos(z)   == junfunc("ArcCos",z)
    atan(z)   == junfunc("ArcTan",z)
    atan(z1,z2) == jbinfunc("ArcTan",z1, z2)
    asec(z)   ==
      zero?(z) => error1("asec: not defined for argument", z)
      junfunc("ArcSec",z)
    acsc(z)   ==
      zero?(z) => error1("acsc: not defined for argument", z)
      junfunc("ArcCsc",z)
    acot(z)   == junfunc("ArcCot",z)

    sinh(z) == junfunc("Sinh",z)
    cosh(z) == junfunc("Cosh",z)
    tanh(z) == junfunc("Tanh",z)
    sech(z) == junfunc("Sech",z)
    csch(z) == junfunc("Csch",z)
    coth(z) == junfunc("Coth",z)

    asinh(z) == junfunc("ArcSinh",z)
    acosh(z) == junfunc("ArcCosh",z)
    atanh(z) ==
      if z = 1 or z = -1 then
        error1("atanh: not defined for argument", z)
      junfunc("ArcTanh",z)
    asech(z) ==
      if zero? z then error1("asech: not defined for argument", z)
      junfunc("ArcSech",z)
    acsch(z) ==
      if zero? z then error1("acsch: not defined for argument", z)
      junfunc("ArcCsch",z)
    acoth(z) ==
      if z = 1 or z = -1 then
        error1("acoth: not defined for argument", z)
      junfunc("ArcCoth",z)

    erf(z)      == junfunc("Erf",z)
    erfc(z)     == junfunc("Erfc",z)
    erf(z1, z2) == jbinfunc("Erf",z1, z2)
    erfi(z)     == junfunc("Erfi",z)
    Si(z)       == junfunc("SinIntegral",z)
    Shi(z)       == junfunc("SinhIntegral",z)
    Ci(z)       == junfunc("CosIntegral",z)
    Chi(z)      == junfunc("CoshIntegral",z)
    Ei(z)       == junfunc("ExpIntegralEi",z)
    fresnelC(z) == junfunc("FresnelC",z)
    fresnelS(z) == junfunc("FresnelS",z)
    li(z)       == junfunc("LogIntegral",z)
    dilog(z)    ==
      two := jWSReal("2")$WSReal
      jbinfunc("PolyLog", two, z)
    differentiate x == 0

    urand01() == jWSExpression("RandomComplex[]") pretend %
    string(z) == toString z
    convert(z) : String == string z
    toString(z, form) == string jbinfunc("ToString", z, form)
    coerce(z : %) : Complex(DoubleFloat) ==
      complex(coerce(real(z)), coerce(imag(z)))
    coerce(z : %) : Complex(JLFloat64) ==
      complex(coerce(real(z)), coerce(imag(z)))
    coerce(z : %) : WSExpression == z pretend WSExpression
    coerce(i : Integer) ==
      jlref(concat(["weval(W_"Complex_"(", getind(coerce(i)@WSInteger), ",0))"]))
    coerce(z : Complex(Integer)) ==
      jlref(concat(["weval(W_"Complex_"(",
        getind(coerce(real(z))@WSInteger),",",
          getind(coerce(imag(z))@WSInteger),"))"]))
    coerce(i : WSInteger) ==
      jlref(concat(["weval(W_"Complex_"(", getind(i), ",0))"]))
    coerce(r : WSReal) ==
      jlref(concat(["weval(W_"Complex_"(", getind(r), ", 0))"]))
    complex(re : WSReal, im : WSReal) : % ==
      jlref(concat(["weval(W_"Complex_"(", getind(re), "," , getind(im), "))"]))
    jWSComplex(re : WSReal) : % ==
      jlref(concat(["weval(W_"Complex_"(", getind(re), "," , getind(0), "))"]))
    jWSComplex(re : WSReal, im : WSReal) : % ==
      jlref(concat(["weval(W_"Complex_"(", getind(re), "," , getind(im), "))"]))
    coerce(z) : OutputForm == message(toString z)
      -- Too expensive
      -- re := (r := real z)::OutputForm
      -- ie := (i := imag z)::OutputForm
      -- zero? i => re
      -- outi := '%i::OutputForm
      -- ip :=
      --   (i = 1) => outi
      --   ((-i) = 1) => -outi
      --   ie * outi
      -- zero? r => ip
      -- re + ip

)abbrev domain WSAPCPX WSAPComplex
++ Generic domain for Julia WS arbitrary precision complex numbers
++ Author: G. Vanuxem
++ Date Created: May, 2024
++ Description:
++  Julia Wolfram Symbolic arbitrary precision complex numbers using Wolfram Symbolic
++  Transport Protocol.
++ Trademark(s): Wolfram is a registered trademark of Wolfram Research, Inc.
WSAPComplex(prec : PositiveInteger) : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  jbinop(op,a,b) ==> make_jlref_weval_binop(op, a, b)$Lisp
  junfunc(func,a) ==> make_jlref_weval1(func, a)$Lisp
  jbinfunc(func,a,b) ==> make_jlref_weval2(func, a, b)$Lisp
  jbinbop(op,a,b) ==> jl_weval_binbop_wrapped_index(op, jlId(a), jlId(b))$Lisp
  Exports ==> Join(WSNumber, ComplexCategory(WSAPReal(prec)),
                ElementaryFunctionCategory, TranscendentalFunctionCategory,
                LiouvillianFunctionCategory) with
    urand01 : () -> %
    ++ urand01() returns a unit square random complex number.
    jlApprox?: (%, %) -> Boolean
    ++ jlApprox?(x,y) computes inexact equality comparison
    ++ with WS default parameters (Equal).
    "*"      : (WSInteger, %) -> %
    ++ n * z multiplies n by z.
    exp     : () -> %
    ++ exp() returns the WSAPReal ℯ (%e or exp(1)).
    sinc    : % -> %
    ++ sinc(z) computes the unnormalized sinc of z, sin(z)/z and 0 if z = 0.
    log2    : % -> %
    ++ log2(z) computes the logarithm of z in base 2.
    log10   : % -> %
    ++ log10(z) computes the logarithm of z in base 10.
    atan    : (%, %) -> %
    ++ atan(z1,z2) computes the arc tangent of z2/z1.
    erf     : (%, %) -> %
    ++ erf(z) computes the error function of z.
    erfc    : % -> %
    ++ erfc(z) returns the complementary error function of z.
    toString : (%, WSExpression) -> String
    ++ toString(expr, form) returns the string representation of expr
    ++ with WS language format form.
    coerce   : Integer  -> %
    ++ coerce(i): convenience function.
    coerce   : Complex(Integer) -> % -- %i operations for example
    ++ coerce(gi) coerces gi. Convenience function.
    coerce   : WSInteger  -> %
    ++ coerce(int): coerces int. Convenience function.
    complex    : (WSAPReal(prec), WSAPReal(prec)) -> %
    ++ complex(re, im) returns the complex number from real part re
    ++ and imaginary part im.
    jWSComplex : WSAPReal(prec) -> %
    ++ jWSComplex(re) constructs a WSComplex with real part re.
    jWSComplex : (WSAPReal(prec), WSAPReal(prec)) -> %
    ++ jWSComplex(re, im) constructs a WSComplex from real part re
    ++ and imaginary part im.
  Implementation ==> JLObject add
    import from JLUtilityFunctions
    import from WSExpression
    jlInitialize(true)

    error1(msg, f) ==> error concat [msg, " ", toString(f, jWSExpression "OutputForm")]
    bool(a) ==> coerce(a)$WSSymbol

    if not jlUsing("MathLink") then
      error "The Julia MathLink package is not installed."

    0 == jlref(concat(["W_`N[Complex[0,0],", string(prec), "]_`"]))
    1 == jlref(concat(["W_`N[Complex[1,0],", string(prec), "]_`"]))
    imaginary()  == jlref(concat(["W_`N[Complex[0,1],", string(prec), "]_`"]))
    WT : WSSymbol := WTrue()

    zero? z == z = 0
    one? z  == z = 1

    pi()  == jlref(concat(["W_`N[Complex[Pi,0],", string(prec), "]_`"]))
    exp() == jlref(concat(["W_`N[Complex[E,0],", string(prec), "]_`"]))

    real(z)      == junfunc("Re", z)
    imag(z)      == junfunc("Im", z)

    conjugate(z) == junfunc("Conjugate", z)
    -- norm(z) in FriCAS = re(z)^2+im(z)^2 even for Complex(Float)
    -- Let FriCAS compute it
    --norm(z)      == junfunc("Norm", z)

    x = y  == jbinbop("==",x,y)
    x ~= y == jbinbop("!=",x,y)
    jlApprox?(x,y) == jbinfunc("Equal", x,y) = WT
    x + y == jbinop("+", x, y)
    x - y == jbinop("-", x, y)
    - x   == junfunc("-(", x)
    x : % * y : % == jbinop("*", x, y)
    x : WSInteger * y : % == jbinop("*", x, y)
    x : Integer * y : % == jbinop("*", coerce(x)@WSInteger, y)
    x : % ^ y : Integer == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : PositiveInteger == jbinop("^", x, coerce(y)@WSInteger)
    x : % ^ y : NonNegativeInteger == jbinop("^", x, coerce(y)@WSInteger)

    unitNormal x ==
      -- TODO: to be improved
      zero? x => [1, x, 1]
      one? x => [1, 1, 1]
      re := real(x); im := imag(x)
      zero? re and im > 0 => [imaginary(), complex(im,0), -imaginary()]
      re > 0 =>
        im >= 0 => [1, x, 1]
        im < 0 => [-imaginary(), complex(-im, re), imaginary()]
      im < 0 => [-1, complex(-re, -im) ,-1]
      [imaginary(), complex(im, -re), -imaginary()]

    abs(z)     == junfunc("Abs", z)
    argument(z)  == junfunc("Arg", z)

    exp(z)   == junfunc("Exp",z)
    sqrt(z)  == junfunc("Sqrt",z)
    log(z)   ==
      zero? z  => error "log: 0 is an invalid argument"
      junfunc("Log",z)
    log2(z)  ==
      zero? z => error "log2: 0 is an invalid argument"
      junfunc("Log2",z)
    log10(z) ==
      zero? z => error "log10: 0 is an invalid argument"
      junfunc("Log10",z)

    sin(z) == junfunc("Sin",z)
    cos(z) == junfunc("Cos",z)
    tan(z) == junfunc("Tan",z)
    sec(z) == junfunc("Sec",z)
    csc(z) == junfunc("Csc",z)
    cot(z) == junfunc("Cot",z)

    sinc(z)== junfunc("Sinc",z)

    asin(z)   == junfunc("ArcSin",z)
    acos(z)   == junfunc("ArcCos",z)
    atan(z)   == junfunc("ArcTan",z)
    atan(z1,z2) == jbinfunc("ArcTan",z1, z2)
    asec(z)   ==
      zero?(z) => error1("asec: not defined for argument", z)
      junfunc("ArcSec",z)
    acsc(z)   ==
      zero?(z) => error1("acsc: not defined for argument", z)
      junfunc("ArcCsc",z)
    acot(z)   == junfunc("ArcCot",z)

    sinh(z) == junfunc("Sinh",z)
    cosh(z) == junfunc("Cosh",z)
    tanh(z) == junfunc("Tanh",z)
    sech(z) == junfunc("Sech",z)
    csch(z) == junfunc("Csch",z)
    coth(z) == junfunc("Coth",z)

    asinh(z) == junfunc("ArcSinh",z)
    acosh(z) == junfunc("ArcCosh",z)
    atanh(z) ==
      if z = 1 or z = -1 then
        error1("atanh: not defined for argument", z)
      junfunc("ArcTanh",z)
    asech(z) ==
      if zero? z then error1("asech: not defined for argument", z)
      junfunc("ArcSech",z)
    acsch(z) ==
      if zero? z then error1("acsch: not defined for argument", z)
      junfunc("ArcCsch",z)
    acoth(z) ==
      if z = 1 or z = -1 then
        error1("acoth: not defined for argument", z)
      junfunc("ArcCoth",z)

    erf(z)      == junfunc("Erf",z)
    erfc(z)     == junfunc("Erfc",z)
    erf(z1, z2)   == jbinfunc("Erf",z1, z2)
    erfi(z)     == junfunc("Erfi",z)
    Si(z)       == junfunc("SinIntegral",z)
    Shi(z)       == junfunc("SinhIntegral",z)
    Ci(z)       == junfunc("CosIntegral",z)
    Chi(z)      == junfunc("CoshIntegral",z)
    Ei(z)       == junfunc("ExpIntegralEi",z)
    fresnelC(z) == junfunc("FresnelC",z)
    fresnelS(z) == junfunc("FresnelS",z)
    li(z)       == junfunc("LogIntegral",z)
    dilog(z)    ==
      two := jWSReal("2")$WSAPReal(prec)
      jbinfunc("PolyLog", two, z)
    differentiate x == 0

    urand01() ==
      jWSExpression(concat(["RandomComplex[WorkingPrecision->",
        string(prec),"]"])) pretend %
    string(z) == toString(z pretend WSExpression, jWSExpression("OutputForm"))
    convert(obj) : String == string obj
    toString(z, form) == string jbinfunc("ToString", z, form)
    coerce(z : %) : WSExpression == z pretend WSExpression
    coerce(i : Integer) ==
      jlref(concat(["weval(W_"Complex_"(",
        getind(coerce(i)@WSInteger), ",0))"]))
    coerce(z : Complex(Integer)) ==
      jlref(concat(["weval(W_"Complex_"(",
        getind(coerce(real(z))@WSInteger),",",
          getind(coerce(imag(z))@WSInteger),"))"]))
    coerce(i : WSInteger) ==
      jlref(concat(["weval(W_"Complex_"(", getind(i), ",0))"]))
    coerce(r : WSAPReal(prec)) ==
      jlref(concat(["weval(W_"Complex_"(", getind(r), ",0))"]))
    complex(re : WSAPReal(prec), im : WSAPReal(prec)) : % ==
      jlref(concat(["weval(W_"Complex_"(", getind(re), "," , getind(im), "))"]))
    jWSComplex(re : WSAPReal(prec)) : % ==
      jlref(concat(["weval(W_"Complex_"(", getind(re), "," , getind(0), "))"]))
    jWSComplex(re : WSAPReal(prec), im : WSAPReal(prec)) : % ==
      jlref(concat(["weval(W_"Complex_"(", getind(re), "," , getind(im), "))"]))
    coerce(z) : OutputForm == message(toString z)
      -- Too expensive
      -- re := (r := real z)::OutputForm
      -- ie := (i := imag z)::OutputForm
      -- zero? i => re
      -- outi := '%i::OutputForm
      -- ip :=
      --   (i = 1) => outi
      --   ((-i) = 1) => -outi
      --   ie * outi
      -- zero? r => ip
      -- re + ip
