)abbrev domain JOBPY JLObjPy
++ Convenience domain for Julia Python objects using
++ the PythonCall Julia package.
++ Author: G.Vanuxem
++ Date Created: September 2025
++ Description:
++  Convenience domain for Julia Python objects that are used
++ within Julia, and not directly by the underlying FriCAS Common Lisp.
++ The PythonCall package must be installed in Julia.
++ Note that the PythonCall Julia package uses a similar scheme for Julia
++ Python objects to the one of jlFriCAS for JLObjectType references.
++ Trademark(s): Python is a registered trademark of the Python
++ Software Foundation.
JLObjPy() : Exports == Implementation where
  getind(a) ==> concat(["getindex(refs,", string(jlId(a)), ")"])
  junfunc(func, a) ==> make_jlref_wcall1(func, a)$Lisp
  Exports ==> Join(JLObjectType, JLObjectAggregate) with
    elt : (%, JLSymbol) -> %
    ++ elt(obj, sym) returns the property/element sym of obj.
    qelt : (%, JLSymbol) -> %
    ++ qelt(obj, sym) returns the property/element sym of obj. No checks are done
    ++ regarding the existence of the sym property. If it does not exist,
    ++ Julia throws an error.
    elt : (%, Integer) -> %
    ++ elt(obj, ind) returns the element at index ind of obj.
    qelt : (%, Integer) -> %
    ++ qelt(obj, ind) returns the element at index ind of obj.
    jlPyApply : (String, %) -> %
    ++ jlPyApply(func, pyobj) applies the Python function func
    ++ form the module __main__ to the Python object pyobj.
    jlPyApply : (String, %, %) -> %
    ++ jlPyApply(func, pyobj1, pyobj2) applies the Python function func
    ++ form the module __main__ to the Python objects pyobj1 and pyobj2.
    jlPyApply : (String, %, %, %) -> %
    ++ jlPyApply(func, pyobj1, pyobj2, pyobj3) applies the Python function func
    ++ form the module __main__ to the Python objects pyobj1, pyobj2 and pyobj3.
    jlPyApply : (String, %, %, %, %) -> %
    ++ jlPyApply(func, pyobj1, pyobj2, pyobj3, pyobj4) applies the Python function func
    ++ form the module __main__ to the Python objects pyobj1, pyobj2, pyobj3 and pyobj4.
    jlPyApply : (String, %, %, %, %, %) -> %
    ++ jlPyApply(func, pyobj1, pyobj2, pyobj3, pyobj4, pyobj5) applies the Python function func
    ++ form the module __main__ to the Python objects pyobj1, pyobj2, pyobj3, pyobj4 and pyobj5.
    jlPyApply : (String, String, %) -> %
    ++ jlPyApply(mod, func, pyobj) applies the Python function func
    ++ from the module mod to the Python object pyobj.
    ++ For example:
    ++ Numpy needs to be installed, see the Julia package CondaPkg.
    ++ \example{jlPyApply("numpy", "array", jpyobj("[1,2,3]"))}
    ++ creates a numpy array from the Python list [1,2,3].
    ++ jlPyApply("math", "sqrt", 2) computes the square root of 2.
    jlPyApply : (String, String, %, %) -> %
    ++ jlPyApply(mod, func, pyobj1, pyobj2) applies the Python function func
    ++ from the module mod to the Python objects pyobj1 and pyobj2
    jlPyApply : (String, String, %, %, %) -> %
    ++ jlPyApply(mod, func, pyobj1, pyobj2, pyobj3) applies the Python function
    ++ func from the module mod to the Python objects pyobj1, pyobj2 and pyobj3.
    jlPyApply : (String, String, %, %, %, %) -> %
    ++ jlPyApply(mod, func, pyobj1, pyobj2, pyobj3, pyobj4) applies the Python
    ++ function func from the module mod to the Python objects pyobj1, pyobj2,
    ++ pyobj3 and pyobj4.
    jlPyApply : (String, String, %, %, %, %, %) -> %
    ++ jlPyApply(mod, func, pyobj1, pyobj2, pyobj3, pyobj4, pyobj5) applies
    ++ the Python function func from the module mod to the Python objects
    ++ pyobj1, pyobj2, pyobj3, pyobj4 and pyobj5.
    jlPyApply : (String, String, String, %) -> %
    ++ jlPyApply(mod1, mod2, func, pyobj) applies the Python function func
    ++ from the module mod1.mod2 to the Python object pyobj.
    jlPyApply : (String, String, String, %, %) -> %
    ++ jlPyApply(mod1, mod2, func, pyobj1, pyobj2) applies the Python function
    ++ func from the module mod1.mod2 to the Python objects pyobj1 and pyobj2.
    jlPyApply : (String, String, String, %, %, %) -> %
    ++ jlPyApply(mod1, mod2, func, pyobj1, pyobj2, pyobj3) applies the Python function
    ++ func from the module mod1.mod2 to the Python objects pyobj1, pyobj2 and pyobj3.
    jlPyApply : (String, String, String, %, %, %, %) -> %
    ++ jlPyApply(mod1, mod2, func, pyobj1, pyobj2, pyobj3, pyobj4) applies the Python
    ++ function func from the module mod1.mod2 to the Python objects pyobj1, pyobj2,
    ++ pyobj3 and pyobj4.
    jlPyApply : (String, String, String, %, %, %, %, %) -> %
    ++ jlPyApply(mod1, mod2, func, pyobj1, pyobj2, pyobj3, pyobj4, pyobj5) applies
    ++ the Python function func from the module mod1.mod2 to the Python objects
    ++ pyobj1, pyobj2, pyobj3, pyobj4 and pyobj5.
    jlPyType : % -> %
    ++ jlPyType(pyobj) returns the Python type of the Python object pyobj.
    jlPyConvert : (String, %) -> JLObject
    ++ jlPyConvert(type, pyobj) converts the Python object pyobj
    ++ to the Julia type 'type'.
    jlPyRepr : % -> %
    ++ jlPyRepr(pyobj) returns the Julia Python object representing the
    ++ Python object pyobj.
    jlPyDocumentation : String -> Void
    ++ jlPyDocumentation(obj) displays the Python documentation
    ++ for the Python object obj. Use 'q' followed by ENTER to quit.
    jlPyImport : String -> %
    ++ jlPyImport(mod) imports the Python module mod in the
    ++ Julia Python environment.
    coerce : Integer -> %
    ++ coerce(i) coerces the integer i to a Julia Python object.
    coerce : Float -> %
    ++ coerce(f) coerces f to a Julia Python object.
    coerce : String -> %
    ++ coerce(str) coerces the string str to a Julia Python string object.
    jpython : JLObject -> %
    ++ jpython(obj) coerces the Julia object obj to a Julia Python object.
    ++ Use jlDisplay(pyobj) to display the Python object pyobj.
    jpython : String -> %
    ++ jpython(str) coerces the string str to a Julia Python object.
    ++ Use jlDisplay(pyobj) to display the Python object pyobj.
  Implementation ==> add
    import from JLUtilityFunctions
    jlInitialize(true)

    not jlUsing "PythonCall" =>
      error "JLObjPy: PythonCall is not installed in Julia"

    jlPyImport(pmod) ==
      jlref(concat(["pyimport(_"", pmod, "_")"]))

    elt(obj : %, jsy : JLSymbol) ==
      defined : String := concat(["hasproperty(", getind(obj), ",",
        str := string(jsy), ")"])
      not jlEvalString(defined)@Boolean =>
        error concat("elt: undefined symbol ", str)
      jlref(concat(["getproperty(", getind(obj), ",", string(jsy), ")"]))
    qelt(obj : %, jsy : JLSymbol) ==
      jlref(concat(["get(", getind(obj), ",", string(jsy), ", missing)"]))
    elt(obj : %, ind : Integer) ==
      jlref(concat([getind(obj), "[", string(ind), "]"]))
    qelt(obj : %, ind : Integer) ==
      jlref(concat([getind(obj), "[", string(ind), "]"]))

    jlPyApply(func : String, pyobj : %) ==
      jlref(concat([func, "(", getind(pyobj), ")"]))
    jlPyApply(func : String, pyobj1 : %, pyobj2 : %) ==
      jlref(concat([func, "(", getind(pyobj1), ",", getind(pyobj2), ")"]))
    jlPyApply(func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %) ==
      jlref(concat([func, "(", getind(pyobj1), ",", getind(pyobj2), ",",
        getind(pyobj3), ")"]))
    jlPyApply(func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %, pyobj4 : %) ==
      jlref(concat([func, "(", getind(pyobj1), ",", getind(pyobj2), ",",
        getind(pyobj3), ",", getind(pyobj4), ")"]))
    jlPyApply(func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %, pyobj4 : %, pyobj5 : %) ==
      jlref(concat([func, "(", getind(pyobj1), ",", getind(pyobj2), ",",
        getind(pyobj3), ",", getind(pyobj4), ",", getind(pyobj5), ")"]))

    jlPyApply(m : String, func : String, pyobj : %) ==
      jlref(concat(["pyimport(_"", m, "_").", func, "(", getind(pyobj), ")"]))
    jlPyApply(m : String, func : String, pyobj1 : %, pyobj2 : %) ==
      jlref(concat(["pyimport(_"", m, "_").", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ")"]))
    jlPyApply(m : String, func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %) ==
      jlref(concat(["pyimport(_"", m, "_").", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ",", getind(pyobj3), ")"]))
    jlPyApply(m : String, func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %, pyobj4 : %) ==
      jlref(concat(["pyimport(_"", m, "_").", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ",", getind(pyobj3), ",", getind(pyobj4), ")"]))
    jlPyApply(m : String, func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %, pyobj4 : %, pyobj5 : %) ==
      jlref(concat(["pyimport(_"", m, "_").", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ",", getind(pyobj3), ",", getind(pyobj4), ",",
          getind(pyobj5), ")"]))

    jlPyApply(m1 : String, m2 : String, func : String, pyobj : %) ==
      jlref(concat(["pyimport(_"", m1, "_").", m2, ".", func, "(", getind(pyobj), ")"]))
    jlPyApply(m1 : String, m2 : String, func : String, pyobj1 : %, pyobj2 : %) ==
      jlref(concat(["pyimport(_"", m1, "_").", m2, ".", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ")"]))
    jlPyApply(m1 : String, m2 : String, func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %) ==
      jlref(concat(["pyimport(_"", m1, "_").", m2, ".", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ",", getind(pyobj3), ")"]))
    jlPyApply(m1 : String, m2 : String, func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %, pyobj4 : %) ==
      jlref(concat(["pyimport(_"", m1, "_").", m2, ".", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ",", getind(pyobj3), ",", getind(pyobj4), ")"]))
    jlPyApply(m1 : String, m2 : String, func : String, pyobj1 : %, pyobj2 : %, pyobj3 : %, pyobj4 : %, pyobj5 : %) ==
      jlref(concat(["pyimport(_"", m1, "_").", m2, ".", func, "(", getind(pyobj1), ",",
        getind(pyobj2), ",", getind(pyobj3), ",", getind(pyobj4), ",",
          getind(pyobj5), ")"]))
    jlPyType(pyobj : %) == junfunc("pytype", pyobj)
    jlPyRepr(pyobj : %) == junfunc("pyrepr", pyobj)
    jlPyConvert(type, pyobj) ==
      jlref(concat(["pyconvert(", type, ",", getind(pyobj),")"]))
    jlPyDocumentation(obj) == jlref(concat(["pyhelp(_"", obj, "_")"]))
    coerce(i : Integer) == jlref(concat(["Py(", string(i),")"]))
    coerce(str : String) == jlref(concat(["Py(_"", str, "_")"]))
    coerce(f : Float) ==
      tmp := outputSpacing(0)
      try
        jlref(concat(["Py(", toString(f),")"]))
      finally
        outputSpacing(tmp)
    jpython(obj : JLObject) == junfunc("pyjl", obj)
    jpython(str : String) == jlref(concat(["Py(", str, ")"]))
    coerce(pyobj : %) : OutputForm == jl_string_getindex(jlId pyobj)$Lisp
