      jbinfunc("MinimalPolynomial", expr, var)
    minimalPolynomial(expr, var, ext) ==
      jterfunc("MinimalPolynomial", expr, var, ext)
    findRoot(expr,init) == jbinfunc("FindRoot", expr, init)

    --finiteField(p,d) == jbinfunc("FiniteField", p, d)

    normal(expr) == junfunc("Normal", expr)
    normal(expr, heads) == jbinfunc("Normal", expr, heads)

    collect(expr, vars : %) == jbinfunc("Collect", expr, vars)
    collect(expr, vars : WSL(%)) == jbinfunc("Collect", expr, vars)
    apart(expr) == junfunc("Apart", expr)
    apart(expr, vars) == jbinfunc("Apart", expr, vars)
    expandNumerator(expr) == junfunc("ExpandNumerator", expr)
    expandDenominator(expr) == junfunc("ExpandDenominator", expr)
    cancel(expr) == junfunc("Cancel", expr)
    together(expr) == junfunc("Together", expr)
    distribute(expr) == junfunc("Distribute", expr)
    distribute(f, g) == jbinfunc("Distribute", f, g)
    hornerForm(expr, var) == jbinfunc("HornerForm", expr, var)

    simplify(expr) == junfunc("Simplify", expr)
    simplify(expr, assume) == jbinfunc("Simplify", expr, assume)
    extendedSimplify(expr) == junfunc("FullSimplify", expr)
    extendedSimplify(expr, assume) ==
      jbinfunc("FullSimplify", expr, assume)
    refine(expr, assume) == jbinfunc("Refine", expr, assume)
    -- TODO: Not always supported by MathLink
    assuming(assume, expr) == jbinfunc("Assuming", assume, expr)

    expand(expr) == junfunc("Expand", expr)
    extendedExpand(expr) == junfunc("ExpandAll", expr)
    powerExpand(expr) == junfunc("PowerExpand", expr)
    powerExpand(expr, assum) == jbinfunc("PowerExpand", expr, assum)
    complexExpand(expr) == junfunc("ComplexExpand", expr)
    complexExpand(expr, cvars) == jbinfunc("ComplexExpand", expr, cvars)
    trigExpand(expr) == junfunc("TrigExpand", expr)
    functionExpand(expr) == junfunc("FunctionExpand", expr)
    functionExpand(expr, assum) ==
      jbinfunc("FunctionExpand", expr, assum)

    trigToExp(expr) == junfunc("TrigToExp", expr)
    expToTrig(expr) == junfunc("ExpToTrig", expr)

    trigFactor(expr) == junfunc("TrigFactor", expr)
    trigFactorList(expr) == junfunc("TrigFactorList", expr)
    trigReduce(expr) == junfunc("TrigReduce", expr)
    rootReduce(expr) == junfunc("RootReduce", expr)

    rationalApproximation(expr) == junfunc("Rationalize", expr)
    rationalApproximation(expr, dx) == jbinfunc("Rationalize", expr, dx)

    -- TODO: Pure WS version (high accuracy)
    jlEval(expr, param) ==
      jlref(concat(["weval(", getind(expr), ",", param, ")"]))
    jlEval(expr, param1, param2) ==
      jlref(concat(["weval(", getind(expr), ",", param1 ",", param2, ")"]))
    jlEval(expr, param1, param2, param3) ==
      jlref(concat(["weval(", getind(expr), ",",
        param1 ",", param2, ",", param3, ")"]))

    eval(expr : %, param : Equation(%)) ==
      jbinfunc("ReplaceAll", expr, jWSRule param)
    eval(expr : %, params : List(Equation(%))) ==
      args := jWSList(map(jWSRule, params)$ListFunctions2(Equation(%), %))$WSList(%)
      jbinfunc("ReplaceAll", expr, args)

    length(expr) == junfunc("Length", expr)
    extract(expr, i) == jbinfunc("Extract", expr, jWSExpression(string(i)))
    level(expr, level) == jbinfunc("Level", expr, level)
    level(expr, level, head) ==
      if head then jterfunc("Level", expr, level, jWSExpression "Heads -> True")
      else jbinfunc("Level", expr, level)
    lookup(assocs,keys) == jbinfunc("Lookup",assocs,keys)
    lookup(assocs,keys,def) == jterfunc("Lookup",assocs,keys,def)
    quantityUnit(val) == junfunc("QuantityUnit", val)
    quantityMagnitude(val) == junfunc("QuantityMagnitude", val)
    keys(expr) ==
      -- TODO
      (head := jlHead(expr)) ~= WList() and head ~= WRule()
        => error1("No rule(s) detected in ", expr)
      junfunc("Keys", expr)
    values(expr) ==
      (head := jlHead(expr)) ~= WList() and head ~= WRule()
        => error1("No rule(s) detected in ", expr)
      junfunc("Values", expr)

    replace(expr, rule) == jbinfunc("Replace", expr, rule)
    replace(expr, rule, level) == jterfunc("Replace", expr, rule, level)
    replacePart(expr, part) == jbinfunc("ReplacePart", expr, part)
    replaceAt(expr, at, n) == jterfunc("ReplaceAt", expr, at, n)
    replaceAll(expr, rule) == jbinfunc("ReplaceAll", expr, rule)
    replaceRepeated(expr, rule) == jbinfunc("ReplaceRepeated", expr, rule)
    -- HERE: operator form
    --jWSExpression concat(["ReplaceAll[", toString(rule),"][", toString(expr), "]"])
    select(expr, form) == jbinfunc("Select", expr, form)
    select(expr, form, n) == jterfunc("Select", expr, form, n)
    jlWSPrecision(expr) == junfunc("Precision", expr)
    jlWSAccuracy(expr) == junfunc("Accuracy", expr)
    jlWSSetPrecision(expr, n) == jbinfunc("SetPrecision", expr, n)
    jlWSSetAccuracy(expr, n) == jbinfunc("SetAccuracy", expr, n)
    jlWSSetOptions(arg1, arg2) == jbinfunc("SetOptions", arg1, arg2)
    jlDisplay(expr) == junfunc("Format", expr)
    jlDisplay(expr, form) == jbinfunc("Format", expr, form)
    jWSData() == jWSExpression "WolframLanguageData[]"
    jWSData(ents : String) ==
      junfunc("WolframLanguageData", jWSString(ents))
    jWSData(ent : String, prop : String) ==
      jbinfunc("WolframLanguageData", jWSString(ent), jWSString(prop))
    jWSData(ent : String, prop : String, ann : String) ==
      jterfunc("WolframLanguageData", jWSString(ent),
        jWSString(prop), jWSString(ann))
    jWSData(ents : %) ==
        junfunc("WolframLanguageData", ents)
    jWSData(ents : %, prop : %) ==
      jbinfunc("WolframLanguageData", ents, prop)
    jWSData(ent : %, prop : %, ann : %) ==
      jterfunc("WolframLanguageData", ent, prop, ann)
    jWSAssociation(rules : WSList(%)) ==
      junfunc("Association", rules)
    jWSTable(expr, range) == jbinfunc("Table", expr, range)
    jWSTable(expr, range1, range2) ==
      jterfunc("Table", expr, range1, range2)
    jWSRule(lhs, rhs) == jbinfunc("Rule", lhs, rhs)
    jWSRule(eq) == jbinfunc("Rule", lhs(eq), rhs(eq))
    jWSEqual(lhs, rhs) == jbinfunc("Equal", lhs, rhs)
    jWSNotEqual(lhs, rhs) == jbinfunc("Unequal", lhs, rhs)
    jWSLess(lhs, rhs) == jbinfunc("Less", lhs, rhs)
    jWSLessEqual(lhs, rhs) == jbinfunc("LessEqual", lhs, rhs)
    jWSGreater(lhs, rhs) == jbinfunc("Greater", lhs, rhs)
    jWSGreaterEqual(lhs, rhs) == jbinfunc("GreaterEqual", lhs, rhs)
    jWSQuantity(u) == junfunc("Quantity", u)
    jWSQuantity(m,u) == jbinfunc("Quantity", m, u)
    jWSExpression(i : Integer) == jlref(concat(["WInteger(_"", string(i), "_")"]))
    jWSExpression(q : Fraction(Integer)) == jWSRational(q)$WSRational pretend %
    jWSExpression(r : DoubleFloat) == jWSReal(r)$WSReal pretend %
    jWSExpression(r : JLFloat64) == jWSReal(r)$WSReal pretend %
    jWSExpression(r : Float) ==
      tmp := outputSpacing(0)$Float
      try
        jlref(concat(["weval(W_`", toString(r),  "_`)"]))
      finally
        outputSpacing(tmp)$Float
    jWSExpression(r : JLFloat) == jlref(concat(["weval(W_`", string(r),  "_`)"]))
    jWSExpression(sym : Symbol) : % == jlref(concat(["weval(W_`", string(sym),  "_`)"]))
    jWSExpression(str : String) : % == jlref(concat(["weval(W_`", str, "_`)"]))
    jWSExpression(l : List(%)) : % == coerce(l)
    toString(expr, form) == string jbinfunc("ToString", expr, form)
    toExpression(expr) == junfunc("ToExpression", jWSString expr)
    toExpression(expr, form) == jbinfunc("ToExpression", jWSString(expr), form)
    toExpression(expr, form, h) == jterfunc("ToExpression", jWSString(expr), form, h)
    retractIfCan(expr : %) : Union(JLFloat64, "failed") ==
      machineNumber?(expr) => jlEvalString(string(expr))@JF64
      "failed"
    retractIfCan(expr : %) : Union(DoubleFloat, "failed") ==
      machineNumber?(expr)=> jlEvalString(string(expr))@JF64 pretend DoubleFloat
      "failed"
    retractIfCan(expr) : Union(Expression(Integer), "failed") == --TODO: weberE etc.
      str : String := jlEvalString(concat(["replace(_"",
        toString(expr, jWSExpression "InputForm"),
        "_", '[' => '(', ']' => ')', _"Pi_"=>_"%pi_", _"ArcS_" => _"as_", _"ArcC_" => _"ac_",",
        " _"ArcT_" => _"at_" , _"E_" => _"%e_" ,r_"\b[A-Z][a-z]{2}_" => x -> lowercase(x))"]))
      jlRegexMatch?(str,jlRegex("[0-9]\.|0-9]")) => "failed"
      strToExprInt(str)
    retract(expr : %) : Expression(Integer) ==
      (out := retractIfCan(expr)@Union(Expression(Integer), "failed"))
        case "failed" =>
          error(concat("Unable to retract to an Expression(Integer).",
            " Maybe Expression(Float) should be used."))
      out
    retractIfCan(expr : %) : Union(Expression(Float), "failed") == --TODO: weberE etc.
      str : String := jlEvalString(concat(["replace(_"",
        toString(expr, jWSExpression "InputForm"),
        "_", '[' => '(', ']' => ')', _"Pi_" => _"%pi_", _"ArcS_" => _"as_", _"ArcC_" => _"ac_",",
        " _"ArcT_" => _"at_" , _"E_" => _"%e_", r_"\b[A-Z][a-z]{2}_" => x -> lowercase(x))"]))
      -- TODO: to be improved `
      jlRegexMatch?(str, jlRegex("`")) => "failed"
      strToExprFloat(str)
    retract(expr : %) : Expression(Float) ==
      (out := retractIfCan(expr)@Union(Expression(Float), "failed"))
        case "failed" =>
          error1("Unable to retract to an Expression(Float): ", expr)
      out
    -- TODO: breaks output
    --string(expr) : String == toString expr
    --convert(expr) : String == toString expr
    coerce(sym : Symbol) == jlref(concat(["W_`", string(sym),  "_`"]))
    coerce(sym : WSSymbol) == sym pretend %
    coerce(i : Integer) == jlref(concat(["WInteger(_"", string(i), "_")"]))
    coerce(z : Complex(Integer)) ==
      jlref(concat(["weval(W_"Complex_"(",
        getind(coerce(real(z))@WSInteger),",",
          getind(coerce(imag(z))@WSInteger),"))"]))
    coerce(q : Fraction(Integer)) == jWSRational(q)$WSRational pretend %
    coerce(r : Float) ==
      tmp := outputSpacing(0)$Float
      try
        jlref(concat(["weval(W_`", toString(r),  "_`)"]))
      finally
        outputSpacing(tmp)$Float
    coerce(str : String) == jlref(concat(["W_`", str, "_`"]))
    coerce(l : List(%)) : % ==
      -- Temporary (and dirty) hack
      -- TODO : use getind and List
      lstr := map(obj +-> toString(obj), l)$ListFunctions2(%, String)
      str : String := "{"
      for i in 1..(#lstr - 1) repeat
        str := concat([str, lstr.i, ","])
      jlref(concat(["W_`", concat([str, lstr.(#lstr) ,"}"]), "_`"]))
    coerce(expr) : WSInteger ==
      integer?(expr) => expr pretend WSInteger
      error "Not an integer"
    coerce(expr) : WSRational ==
      integer?(expr) or rational?(expr)=> expr pretend WSRational
      error "Not a rational number"
    coerce(eq : Equation(%)) == jWSEqual(lhs(eq), rhs(eq))

    convert(p: Polynomial(Integer)) ==
      jWSExpression(first(lines formatExpression(p::OutputForm)$Format1D))
    convert(p: Polynomial(Fraction(Integer))) ==
      jWSExpression(first(lines formatExpression(p::OutputForm)$Format1D))
    convert(p: Polynomial(Float)) ==
      tmp := outputSpacing(0)$Float
      try
        jWSExpression(first(lines formatExpression(p::OutputForm)$Format1D))
      finally
        outputSpacing(tmp)$Float

    baseForm(x,n) ==
      integer? x and integer? n => jbinfunc("BaseForm", x,n)
      error "baseForm: Integer(s) not used"
    numberForm(x) ==
      number? x => junfunc("NumberForm", x)
      error "numberForm: Not a number"
    numberForm(x, expr) ==
      number? x and (jlHead(expr) = WL or integer? expr)
        => jbinfunc("NumberForm", x,expr)
      error "numberForm: Bad format(s) of arguments"
    decimalForm(x) ==
      number? x => junfunc("DecimalForm", x)
      error "decimalForm: Not a number"
    decimalForm(x, expr) ==
      number? x and (jlHead(expr) = WL or integer? expr)
        => jbinfunc("DecimalForm", x, expr)
      error "decimalForm: Bad format(s) of arguments"
    scientificForm(x) ==
      number? x => junfunc("ScientificForm", x)
      error "scientificForm: Not a number"
    scientificForm(x,n) ==
      number? x and integer? n => jbinfunc("ScientificForm", x,n)
      error "scientificForm: Require numbers"
    engineeringForm(x) ==
      number? x => junfunc("EngineeringForm", x)
      error "engineeringForm: Not a number"
    engineeringForm(x,n) ==
      number? x and integer? n => jbinfunc("EngineeringForm", x,n)
      error "engineeringForm: Require numbers"
    percentForm(x) ==
      number? x => junfunc("PercentForm", x)
      error "percentForm: Not a number"
    percentForm(x,n) ==
      number? x and integer? n => jbinfunc("PercentForm", x,n)
      error "percentForm: Require numbers"
    accountingForm(x) ==
      number? x => junfunc("AccountingForm", x)
      error "accountingForm: Not a number"
    accountingForm(x,n) ==
      number? x and integer? n => jbinfunc("AccountingForm", x,n)
      error "accountingForm: Require numbers"
    matrixForm(expr) == junfunc("MatrixForm", expr)
    quantityForm(expr, form : %) == jbinfunc("QuantityForm", expr, form)
    quantityForm(expr, form : WSL(%)) ==
      jbinfunc("QuantityForm", expr, form)
    coerce(expr) : OutputForm ==
      head := jlHead expr
      head = WS or head = WI or head = WFormat => message(string(expr))
      (head = WR and machineNumber?(expr)) => coerce(expr pretend WSReal)$WSReal
      (head = WC and machineNumber?(real expr) and machineNumber?(imag expr)) =>
        coerce(expr pretend WSComplex)$WSComplex
      head = WRat => coerce(expr pretend WSRational)$WSRational
      pagew := string(_$LINELENGTH$Lisp pretend Integer - 2)
      sexpr := toString(expr, jWSExpression concat("PageWidth -> ", pagew))
      str : String := jlEvalString(concat(["replace(raw_"", sexpr,
        "_", '[' => '(', ']' => ')', r_"\bI\b_" => _"%i_" , r_"\b[A-Z][a-z]{2}_" => x -> lowercase(x))"]))
      l := split(str, newline())
      #l > 1 => pile(append([""],l) pretend List(OutputForm))
      message(str)
